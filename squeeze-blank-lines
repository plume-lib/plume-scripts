#!/bin/sh

# Removes leading and trailing blank lines.  Within the file, replaces multiple
# blank lines by one blank line.  Lines containing only whitespace count as
# blank at beginning and end of file, but not within file.  (TODO: make the
# behavior consistent.)
#
# If given a filename, modifies the file in place.
# Otherwise, reads from stdin and outputs to stdout.

# 1. Determine the input source.
# If $1 exists, read from that file; otherwise, read from stdin.
input="${1:-/dev/stdin}"

# Reject an input file that cannot be read or rewritten in place.  Without this
# check, the file would be created or truncated below.
if [ -n "$1" ]; then
  if [ ! -e "$1" ]; then
    echo "squeeze-blank-lines: no such file: $1" >&2
    exit 2
  fi
  if [ ! -f "$1" ]; then
    echo "squeeze-blank-lines: not a regular file: $1" >&2
    exit 2
  fi
  if [ ! -r "$1" ]; then
    echo "squeeze-blank-lines: cannot read file: $1" >&2
    exit 2
  fi
fi

# 2. Read the data, squeezing internal blank lines.  Read it all before writing
# anything, and check for failure, so that a read error does not destroy the
# contents of an in-place-edited file.  (Reading and writing are separate steps
# because `sh` has no `pipefail`, so a failure of `cat` in the middle of a
# pipeline would go unnoticed.)
squeezed_data=$(cat -s "$input")
status=$?
if [ "$status" -ne 0 ]; then
  echo "squeeze-blank-lines: failed to read $input" >&2
  exit "$status"
fi

# 3. Remove leading blank lines, then remove trailing blank lines.
processed_data=$(printf '%s\n' "$squeezed_data" \
  | sed '/[^[:blank:]]/,$!d' \
  | sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}')
status=$?
if [ "$status" -ne 0 ]; then
  echo "squeeze-blank-lines: failed to process $input" >&2
  exit "$status"
fi

# 4. Determine the output destination.
# When the input is empty or entirely blank, $processed_data is empty; emit
# nothing rather than a single blank line (command substitution stripped the
# trailing newline, so printf would otherwise re-add one).
if [ -n "$1" ]; then
  # If a file was provided, write back to it (in-place).  Write the new
  # contents to a temporary file in the same directory, then rename it over
  # the input file.  The rename is atomic, so a signal or a full filesystem
  # leaves the original file intact rather than truncated or half-written.

  # If the input is a symbolic link, rewrite the file it refers to, rather
  # than replacing the link by a regular file.
  outfile="$1"
  if [ -L "$outfile" ]; then
    outfile=$(readlink -f -- "$outfile")
    if [ -z "$outfile" ]; then
      echo "squeeze-blank-lines: cannot resolve symbolic link: $1" >&2
      exit 2
    fi
  fi
  outdir=$(dirname -- "$outfile")

  tmpfile=$(mktemp -- "$outdir/squeeze-blank-lines.XXXXXX")
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "squeeze-blank-lines: failed to create a temporary file in $outdir" >&2
    exit "$status"
  fi
  # Remove the temporary file if this script is interrupted.  The handlers
  # for the signals exit, so that an interrupted write is never renamed over
  # the input file.  XFSZ is listed because it is what a file-size limit
  # (`ulimit -f`) raises.
  trap 'rm -f -- "$tmpfile"' EXIT
  trap 'rm -f -- "$tmpfile"; exit 2' HUP INT TERM XFSZ

  # Give the temporary file the input file's permissions (and, if permitted,
  # its ownership); `cp -p` also copies the contents, which the redirection
  # below discards.  This is best effort:  `cp -p` fails when the user does
  # not own the file, but it copies the permissions before trying to copy the
  # ownership, and a failure to copy the ownership is not worth aborting for.
  cp -p -- "$outfile" "$tmpfile" 2> /dev/null

  if [ -n "$processed_data" ]; then
    printf '%s\n' "$processed_data" > "$tmpfile"
  else
    : > "$tmpfile"
  fi
  status=$?
  if [ "$status" -ne 0 ]; then
    echo "squeeze-blank-lines: failed to write $tmpfile" >&2
    exit "$status"
  fi

  if ! mv -f -- "$tmpfile" "$outfile"; then
    echo "squeeze-blank-lines: failed to write $outfile" >&2
    exit 2
  fi
elif [ -n "$processed_data" ]; then
  # Otherwise, output to stdout.
  printf '%s\n' "$processed_data"
fi
