#!/bin/bash

# Cronic v2 - cron job report wrapper
# Copyright 2007 Chuck Houpt
# Documentation at http://habilis.net/cronic/
# In brief:
#   Cronic is a small shim shell script for wrapping cron jobs so that cron
#   only sends email when an error has occurred. Cronic defines an error as
#   any non-trace error output or a non-zero result code. Cronic separates
#   execution traces from the error output, so jobs can be run with execution
#   tracing to aid forensic debugging. Apart from its options, Cronic simply
#   executes its arguments.
# Extended by Michael Ernst to add the --expected-status, --permit-stderr, and
# --duplicate-stderr options, which may be given in any order.
# The options and the treatment of execution traces are documented in function
# `cronic_help`; run `cronic --help`.
# This script runs under bash 3.2, which is /bin/bash on macOS, so it uses a
# feature of a later bash only after checking the version.

# If the caller exported SHELLOPTS with xtrace on, then this script would
# trace its own commands, and that trace would be reported as the command's.
# So this script turns xtrace off, and turns it back on for the command.
case $- in
  *x*) case $(declare -p SHELLOPTS) in
    'declare -'*x*) cronic_inherited_xtrace=true ;;
    *) cronic_inherited_xtrace=false ;;
  esac ;;
  *) cronic_inherited_xtrace=false ;;
esac
if $cronic_inherited_xtrace; then
  set +x
fi

# Exit if a command exits with a non-zero status, and treat unset variables
# as an error.
set -eu

# Prints the usage line.
cronic_usage_line() {
  echo "Usage: $0 [--expected-status N] [--permit-stderr] [--duplicate-stderr] [--] COMMAND [ARG...]"
}

# Exits with status 64 (EX_USAGE in sysexits.h) rather than the conventional 2,
# because a wrapped command is much more likely to exit with status 2, and a
# caller that checks for a particular status should not mistake a misuse of
# this script for the command's own result.
cronic_usage() {
  cronic_usage_line >&2
  exit 64
}

# Prints a usage message to standard output and exits with status 0.
cronic_help() {
  cronic_usage_line
  echo "Runs COMMAND, and produces output only if it fails or writes to stderr."
  echo "  --expected-status N  treat exit status N (0 to 255), rather than 0, as success;"
  echo "                       may also be written --expected-status=N"
  echo "  --permit-stderr      do not treat error output as a failure"
  echo "  --duplicate-stderr   print the error output twice in the report, so that it"
  echo "                       is less likely to be overlooked"
  echo "  --                   end the options, so that COMMAND may start with \"-\""
  echo "  -h, --help           print this message"
  echo "Execution traces (from \"set -x\") are not treated as error output."
  echo "Bash 4.1 or later writes them to a separate file, via BASH_XTRACEFD; they"
  echo "appear in the report under \"TRACE OUTPUT\".  Other shells write them to"
  echo "stderr, from which lines that start with PS4 are removed.  That removal"
  echo "is skipped if PS4 contains \"\$\", a backquote, a backslash, or a newline,"
  echo "because such a PS4 can expand differently on each line."
  exit 0
}

# Sets cronic_expected to its argument, or reports a usage error if the
# argument is not a valid exit status.
cronic_set_expected() {
  cronic_expected=$1
  # No leading zeros, because `[[ ... -eq ... ]]` would read the value as
  # octal.  At most 255, because no exit status is larger.
  if ! [[ $cronic_expected =~ ^(0|[1-9][0-9]{0,2})$ ]] || [ "$cronic_expected" -gt 255 ]; then
    echo "$0: --expected-status requires an integer from 0 to 255, got \"$cronic_expected\"" >&2
    cronic_usage
  fi
}

# The options are parsed before the temporary directory is created, so that
# `--help` and a usage error neither create nor depend on it.
cronic_expected=0
cronic_permitstderr=0
cronic_duplicate_stderr=0
while [ $# -gt 0 ]; do
  case $1 in
    --expected-status)
      shift
      if [ $# -eq 0 ]; then
        echo "$0: --expected-status requires a value" >&2
        cronic_usage
      fi
      cronic_set_expected "$1"
      shift
      ;;
    --expected-status=*)
      cronic_set_expected "${1#*=}"
      shift
      ;;
    --permit-stderr)
      shift
      cronic_permitstderr=1
      ;;
    --duplicate-stderr)
      shift
      cronic_duplicate_stderr=1
      ;;
    -h | --help)
      cronic_help
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "$0: unknown option \"$1\"" >&2
      cronic_usage
      ;;
    *)
      break
      ;;
  esac
done
[ $# -gt 0 ] || cronic_usage

cronic_debug=false
# cronic_debug=true

# A private directory, rather than predictable `/tmp/cronic.*.$$` names: on a
# shared machine, process ids are guessable and reused, so another user could
# pre-create those paths as symlinks and have the wrapped command's output
# written through them.
cronic_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/cronic.XXXXXX") || exit 1
cronic_out=$cronic_tmpdir/out
cronic_err=$cronic_tmpdir/err
cronic_reduced_err=$cronic_tmpdir/err.reduced
cronic_trace=$cronic_tmpdir/trace
cronic_xtrace=$cronic_tmpdir/xtrace

# Remove the temporary files however this script terminates, including when it
# is interrupted before it reaches the end.  When cronic_debug is true, the
# files are retained; don't "echo" their location, because that would be
# appended to stderr.
# shellcheck disable=SC2329  # the function is invoked from the trap handlers below.
cronic_cleanup() {
  [ "$cronic_debug" = "true" ] || rm -rf "$cronic_tmpdir"
}
trap cronic_cleanup EXIT

# Clean up and then die of the signal, rather than exiting with status
# 128+signum, so that a supervisor can distinguish "cronic was killed by
# SIGTERM" from "the wrapped command exited with status 143".  Each handler
# first removes itself and the EXIT trap, so that the cleanup runs exactly
# once.  These handlers are not redundant with the EXIT trap:  with no handler
# installed, bash dies as soon as the signal arrives, abandoning the wrapped
# command and deleting the directory that the command is still writing into,
# whereas a handler does not run until the wrapped command has finished.
trap 'cronic_cleanup; trap - HUP EXIT; kill -s HUP $$' HUP
trap 'cronic_cleanup; trap - INT EXIT; kill -s INT $$' INT
trap 'cronic_cleanup; trap - TERM EXIT; kill -s TERM $$' TERM

# A bash command writes its execution trace to the file descriptor named by
# BASH_XTRACEFD, rather than to stderr, so the trace is separated from the
# error output exactly, whatever PS4 is.  The descriptor is allocated by bash
# (as 10 or higher), so that it does not collide with a descriptor, such as 3,
# that the wrapped command uses for its own purposes.  Bash before 4.1 supports
# neither BASH_XTRACEFD nor descriptor allocation.
if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 1))); then
  exec {cronic_xtrace_fd}> "$cronic_xtrace"
  export BASH_XTRACEFD=$cronic_xtrace_fd
fi

# The command runs in a fresh bash process rather than in this shell, so that
# a builtin such as `exit` or `exec` cannot end this script before it reports,
# and so that the command sees none of this script's state:  not its functions,
# its unexported variables, its positional parameters, or its `set -eu`.  The
# command does see the caller's environment, including any functions that the
# caller exported.  If the caller exported SHELLOPTS, then the command inherits
# the caller's options, except that errexit and nounset are off.  The
# redirections apply to the whole process, so that they also capture what it
# writes after the command finishes, such as the output of an EXIT trap that
# the command sets.  The command is passed as a string of quoted words rather
# than as positional parameters, so that a builtin such as `eval` sees no
# positional parameters.  The leading `''` quotes the first word, so that it is
# never read as a reserved word such as `time` or `if`, nor as an assignment.
# The fresh bash's `$0` is this script's, so that its error messages name this
# script rather than bash.
cronic_command="''$(printf '%q ' "$@")"
# Bash does not trace `set -x` itself, so the trace starts with the command.
if $cronic_inherited_xtrace; then
  cronic_command="set -x; $cronic_command"
fi
# A non-interactive bash runs the file named by BASH_ENV when it starts.  This
# script already ran that file, so BASH_ENV is empty while the fresh bash
# starts, and the command string then restores it.  Otherwise the file would
# run twice, and its output would be reported as the command's.  This script
# has BASH_ENV only if the caller exported it, so the restored value is still
# exported.
if [ -n "${BASH_ENV+set}" ]; then
  cronic_command="BASH_ENV=$(printf '%q' "$BASH_ENV"); $cronic_command"
else
  cronic_command="unset BASH_ENV; $cronic_command"
fi
# `set +u` matters even though the command runs in a fresh bash:  if the
# caller exported SHELLOPTS, then the fresh bash inherits this script's options.
set +eu
BASH_ENV='' "$BASH" -c "$cronic_command" "$0" > "$cronic_out" 2> "$cronic_trace"
cronic_result=$?
set -eu

# Unsetting BASH_XTRACEFD also closes its file descriptor.
unset BASH_XTRACEFD

# Prints a basic regular expression that matches its argument literally.
# The argument must not contain a backslash.
cronic_bre_quote() {
  printf '%s\n' "$1" | LC_ALL=C sed 's/[*.[^]/\\&/g'
}

# Prints a basic regular expression that matches the trace lines, for PS4, that
# a shell other than bash 4.1 or later writes to stderr.  Such a line starts
# with PS4 after expansion, with PS4's first character repeated once per level
# of nesting.  If PS4 contains a `$`, backquote, or backslash, then its
# expansion can differ from line to line, so nothing is printed:  any pattern
# for such a PS4 could also match, and hide, a real error.  Nothing is printed
# if PS4 contains a newline, either, because `grep` would treat each line of
# the pattern as a separate pattern.
cronic_trace_pattern() {
  case ${PS4-} in
    '' | *[\$\`\\]* | *$'\n'*) return ;;
  esac
  # In the C locale, a character is a byte.  The first character is a UTF-8
  # lead byte and its continuation bytes, or else a single byte, so that a
  # multibyte character is repeated as a whole, whatever the locale.
  local LC_ALL=C
  [[ $PS4 =~ ^([$'\xc0'-$'\xff'][$'\x80'-$'\xbf']*|.) ]]
  local first=${BASH_REMATCH[0]}
  printf '^\\(%s\\)\\+%s\n' "$(cronic_bre_quote "$first")" "$(cronic_bre_quote "${PS4#"$first"}")"
}

cronic_pattern=$(cronic_trace_pattern)
if [ -n "$cronic_pattern" ] && grep -q "$cronic_pattern" "$cronic_trace"; then
  # `|| true` because `grep -v` exits with status 1 when it selects no lines,
  # which happens whenever stderr consists only of trace lines.  Without it,
  # `set -e` would abort the script here, before it produces its report, and
  # it would exit with status 1 rather than with the wrapped command's status.
  grep -v "$cronic_pattern" "$cronic_trace" > "$cronic_err" || true
else
  cronic_err=$cronic_trace
fi

# Certain Unix programs send output to stderr even when a command is successful!
# For example, git does this, and the POSIX standard requires it for make.
# The full stderr output is shown, but file cronic_reduced_err is checked for
# emptiness below.
# TODO: Expand this.
cat "$cronic_err" \
  | grep -v "^Everything up-to-date$" \
  | grep -v '^make\(\[[0-9]\+\]\)\?: \(Entering\|Leaving\) directory '"'"'.*'"'"'$' \
    > "$cronic_reduced_err" || true

if [ $cronic_result -ne "$cronic_expected" ] || { [ $cronic_permitstderr -eq 0 ] && [ -s "$cronic_reduced_err" ]; }; then
  echo "Cronic detected failure or error output for the command:"
  echo "$@"
  echo
  if [[ $cronic_expected -eq 0 ]]; then
    if [[ $cronic_result -eq 0 ]]; then
      echo "RESULT CODE: $cronic_result  (success)"
    else
      echo "RESULT CODE: $cronic_result  (failure)"
    fi
  else
    echo "RESULT CODE: $cronic_result  (expected: $cronic_expected)"
  fi
  echo
  echo "ERROR OUTPUT:"
  cat "$cronic_err"
  echo
  if [ "$cronic_debug" != "true" ]; then
    if ! cmp --silent "$cronic_err" "$cronic_reduced_err"; then
      echo "REDUCED ERROR OUTPUT:"
      cat "$cronic_reduced_err"
      echo
    fi
  fi
  echo "STANDARD OUTPUT:"
  cat "$cronic_out"
  if [ "$cronic_trace" != "$cronic_err" ]; then
    echo
    echo "TRACE-ERROR OUTPUT:"
    cat "$cronic_trace"
  fi
  if [ -s "$cronic_xtrace" ]; then
    echo
    echo "TRACE OUTPUT:"
    cat "$cronic_xtrace"
  fi
  if [ $cronic_duplicate_stderr -eq 1 ]; then
    echo
    echo "ERROR OUTPUT:"
    cat "$cronic_err"
  fi
  echo
  echo "END OF CRONIC OUTPUT."
fi

# The temporary files are removed by the EXIT trap.

exit $cronic_result
