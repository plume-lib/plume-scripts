#!/usr/bin/env bash

# Cronic v2 - cron job report wrapper
# Copyright 2007 Chuck Houpt
# Documentation at http://habilis.net/cronic/
# In brief:
#   Cronic is a small shim shell script for wrapping cron jobs so that cron
#   only sends email when an error has occurred. Cronic defines an error as
#   any non-trace error output or a non-zero result code. Cronic separates
#   execution traces from the error output, so jobs can be run with execution
#   tracing to aid forensic debugging. Apart from its options, Cronic simply
#   executes its arguments.
#
# Extended by Michael Ernst to add the --expected-status, --permit-stderr, and
# --duplicate-stderr options, which may be given in any order.
#
# For usage information, run `cronic --help`.
#
# Names that start with `cronic_` are reserved for this script:  COMMAND does
# not see a variable or function with such a name, even one that the caller
# exported.  This script assumes that bash has the `compgen` builtin, which is
# absent only if bash was built with `--disable-progcomp`.
#
# Limitations, which `cronic --help` documents:  every run produces output if
# the caller exports the verbose option or runs `bash -v cronic`, or if the file
# named by BASH_ENV writes to stderr.  COMMAND does not see a function named
# `builtin` that the caller exported, because this script removes it so that it
# can run builtins via `builtin`.

# This script runs under the first `bash` in PATH, which on macOS may be
# /bin/bash, bash 3.2.  So it uses a feature of a later bash, such as
# BASH_XTRACEFD (bash 4.1), only after checking the version; see the
# BASH_VERSINFO check below.

# Save the caller's settings of the options that this script changes, as the
# letters that `$-` uses for them, so that the command runs with them.  They
# include any option that BASH_ENV set, because bash runs BASH_ENV before this
# script's first line.  The command inherits every other option, including
# every `shopt` option, unchanged.  If this script ever changes another option,
# add its letter here.  Posix mode, which has no letter, is saved in
# `cronic_caller_posix`, which is non-empty if the caller's shell was in posix
# mode.
#
# Then turn on posix mode, by assigning POSIXLY_CORRECT, so that a special
# builtin, such as `export`, `set`, or `unset`, runs in place of a function of
# the same name that the caller exported.  Then turn off xtrace, so that this
# script does not trace itself to stderr, which would make every run produce
# output, and allexport, so that this script does not export its variables to
# the command.  The variables assigned before that are un-exported explicitly,
# or, for POSIXLY_CORRECT, unset below.  The redirection discards the trace of
# this block.  If the caller exports BASH_XTRACEFD, then bash writes that trace
# to the caller's trace descriptor instead.  If that descriptor is not open,
# then bash reports so on stderr before this script runs, as for any bash
# script; cronic cannot prevent that.
{
  cronic_caller_flags=${-//[^aeux]/}
  if [[ :$SHELLOPTS: == *:posix:* ]]; then
    cronic_caller_posix=y
  else
    cronic_caller_posix=
    POSIXLY_CORRECT=y
  fi
  set +ax
  export -n cronic_caller_flags cronic_caller_posix
} 2> /dev/null

# The next command removes every alias, such as one that BASH_ENV defined, so
# that no alias changes this script's commands or the caller's functions, which
# the command gets back by re-parsing their definitions; the backslash stops an
# alias named `unalias` from applying.  Bash imports the caller's exported
# functions before it runs BASH_ENV, so their bodies never contain an alias.
# The commands after it save the definitions of the caller's exported
# functions, which bash has imported, and remove every function, including any
# that BASH_ENV defined, so that none runs in place of a builtin or program that
# this script uses.  The command gets the exported functions back.  In posix
# mode, `export -pf` lists the names of the exported functions.  Once any
# function named `builtin` is removed, `builtin` runs the other builtins.
# `declare -f` runs with posix mode off, because posix mode rejects a function
# name, such as `my-fn`, that is not an identifier.  Unsetting POSIXLY_CORRECT
# turns posix mode off again, unless the caller's shell was already in posix
# mode, before the loop that removes the functions, because in posix mode bash
# 3.2 also rejects such a name in `unset -f`.  The loop runs `unset` and
# `exit` via `builtin`, so that no function runs in their place.  Their error
# output is not discarded:  if `unset` cannot remove a function, such as one
# that BASH_ENV made readonly, then bash reports the error and this script
# exits, so cron sends email rather than failing silently.
\unalias -a
cronic_exported=$(export -pf)
unset -f builtin
cronic_caller_functions=
cronic_caller_function_names=
while builtin read -r cronic_name; do
  cronic_name=${cronic_name#export -f }
  if [[ -n $cronic_name && $cronic_name != cronic_* && $cronic_name != builtin ]]; then
    builtin printf -v cronic_name_quoted ' %q' "$cronic_name"
    cronic_caller_function_names+=$cronic_name_quoted
  fi
done <<< "$cronic_exported"
if [[ -n $cronic_caller_function_names ]]; then
  cronic_caller_functions=$(unset POSIXLY_CORRECT; builtin eval "builtin declare -f --$cronic_caller_function_names") || :
fi
[[ -n $cronic_caller_posix ]] || unset POSIXLY_CORRECT
while builtin read -r cronic_name; do
  [[ -z $cronic_name ]] || builtin unset -f -- "$cronic_name" || builtin exit 1
done <<< "$(builtin compgen -A function)"

# Exit if a command exits with a non-zero status, and treat unset variables
# as an error.
set -eu

# Prints the usage line.
cronic_usage_line() {
  echo "Usage: $0 [--expected-status N] [--permit-stderr] [--duplicate-stderr] [--] COMMAND [ARG...]"
}

# Exits with status 64 (EX_USAGE in sysexits.h) rather than the conventional 2,
# because a wrapped command is much more likely to exit with status 2, and a
# caller that checks for a particular status should not mistake a misuse of
# this script for the command's own result.
cronic_usage() {
  cronic_usage_line >&2
  exit 64
}

# Prints a usage message to standard output and exits with status 0.
cronic_help() {
  cronic_usage_line
  echo "Runs COMMAND, and produces output only if it fails or writes to stderr."
  echo "  --expected-status N  treat exit status N (0 to 255), rather than 0, as success;"
  echo "                       may also be written --expected-status=N"
  echo "  --permit-stderr      do not treat error output as a failure"
  echo "  --duplicate-stderr   print the error output twice in the report, so that it"
  echo "                       is less likely to be overlooked"
  echo "  --                   end the options, so that COMMAND may start with \"-\""
  echo "  -h, --help           print this message"
  echo "COMMAND may be a program, a shell builtin, or a shell function that the"
  echo "caller exported; a function runs in place of a program of the same name."
  echo "Names that start with \"cronic_\" are reserved:  COMMAND does not see a"
  echo "variable or function with such a name, even one that the caller exported."
  echo "Nor does COMMAND see a function named \"builtin\" that the caller exported,"
  echo "because cronic removes it so that it can run builtins via \"builtin\"."
  echo "COMMAND runs with the caller's shell options, such as errexit, nounset,"
  echo "and xtrace (including any that BASH_ENV sets), rather than with this"
  echo "script's.  This script never traces itself, so \"bash -x cronic COMMAND\""
  echo "traces only the running of COMMAND."
  echo "Execution traces (from \"set -x\") are not treated as error output."
  echo "Bash 4.1 or later writes them to a separate file, via BASH_XTRACEFD; they"
  echo "appear in the report under \"TRACE OUTPUT\".  Other shells write them to"
  echo "stderr, from which lines that start with PS4 are removed.  That removal"
  echo "is skipped if PS4 contains \"\$\", a backquote, a backslash, or a newline,"
  echo "because such a PS4 can expand differently on each line."
  echo "If the caller's xtrace is on, cronic's own trace of running COMMAND is"
  echo "removed from the TRACE OUTPUT; that works only if PS4 contains no newline."
  echo "Do not run \"bash -v cronic\", nor export the verbose option (\"set -v\") via"
  echo "SHELLOPTS: bash would echo the lines of this script (and, if exported, of a"
  echo "bash COMMAND) to stderr, so every run would produce output."
  echo "Bash runs the file named by BASH_ENV, if any, before cronic's own code, so"
  echo "cronic cannot capture that file's output, and exported shell options can make"
  echo "that file write to stderr.  To prevent that, unset BASH_ENV."
  exit 0
}

# Sets cronic_expected to its argument, or reports a usage error if the
# argument is not a valid exit status.
cronic_set_expected() {
  cronic_expected=$1
  # No leading zeros, because `[[ ... -eq ... ]]` would read the value as
  # octal.  At most 255, because no exit status is larger.
  if ! [[ $cronic_expected =~ ^(0|[1-9][0-9]{0,2})$ ]] || [ "$cronic_expected" -gt 255 ]; then
    echo "$0: --expected-status requires an integer from 0 to 255, got \"$cronic_expected\"" >&2
    cronic_usage
  fi
}

# The options are parsed before the temporary directory is created, so that
# `--help` and a usage error neither create nor depend on it.
cronic_expected=0
cronic_permitstderr=0
cronic_duplicate_stderr=0
while [ $# -gt 0 ]; do
  case $1 in
    --expected-status)
      shift
      if [ $# -eq 0 ]; then
        echo "$0: --expected-status requires a value" >&2
        cronic_usage
      fi
      cronic_set_expected "$1"
      shift
      ;;
    --expected-status=*)
      cronic_set_expected "${1#*=}"
      shift
      ;;
    --permit-stderr)
      shift
      cronic_permitstderr=1
      ;;
    --duplicate-stderr)
      shift
      cronic_duplicate_stderr=1
      ;;
    -h | --help)
      cronic_help
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "$0: unknown option \"$1\"" >&2
      cronic_usage
      ;;
    *)
      break
      ;;
  esac
done
[ $# -gt 0 ] || cronic_usage

cronic_debug=false
# cronic_debug=true

# A private directory, rather than predictable `/tmp/cronic.*.$$` names: on a
# shared machine, process ids are guessable and reused, so another user could
# pre-create those paths as symlinks and have the wrapped command's output
# written through them.
cronic_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/cronic.XXXXXX") || exit 1
cronic_out=$cronic_tmpdir/out
cronic_err=$cronic_tmpdir/err
cronic_reduced_err=$cronic_tmpdir/err.reduced
cronic_trace=$cronic_tmpdir/trace
cronic_xtrace=$cronic_tmpdir/xtrace

# Remove the temporary files however this script terminates, including when it
# is interrupted before it reaches the end.  When cronic_debug is true, the
# files are retained; don't "echo" their location, because that would be
# appended to stderr.
# shellcheck disable=SC2329  # the function is invoked from the trap handlers below.
cronic_cleanup() {
  [ "$cronic_debug" = "true" ] || rm -rf "$cronic_tmpdir"
}
trap cronic_cleanup EXIT

# Clean up and then die of the signal, rather than exiting with status
# 128+signum, so that a supervisor can distinguish "cronic was killed by
# SIGTERM" from "the wrapped command exited with status 143".  Each handler
# first removes itself and the EXIT trap, so that the cleanup runs exactly
# once.  These handlers are not redundant with the EXIT trap:  with no handler
# installed, bash dies as soon as the signal arrives, abandoning the wrapped
# command and deleting the directory that the command is still writing into,
# whereas a handler does not run until the wrapped command has finished.
trap 'cronic_cleanup; trap - HUP EXIT; kill -s HUP $$' HUP
trap 'cronic_cleanup; trap - INT EXIT; kill -s INT $$' INT
trap 'cronic_cleanup; trap - TERM EXIT; kill -s TERM $$' TERM

# A bash command writes its execution trace to the file descriptor named by
# BASH_XTRACEFD, rather than to stderr, so the trace is separated from the
# error output exactly, whatever PS4 is.  The descriptor is allocated by bash
# (as 10 or higher), so that it does not collide with a descriptor, such as 3,
# that the wrapped command uses for its own purposes.  Bash before 4.1 supports
# neither BASH_XTRACEFD nor descriptor allocation.
if ((BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 1))); then
  exec {cronic_xtrace_fd}> "$cronic_xtrace"
  export BASH_XTRACEFD=$cronic_xtrace_fd
fi

# The command runs in a subshell rather than via `exec`, so that it can be a
# shell builtin or an exported shell function, and rather than in this shell,
# so that a builtin such as `exit` or `exec` cannot end this script before it
# reports.
#
# The subshell unsets this script's functions, which are the only ones that
# remain, and every variable whose name starts with `cronic_`, so that the
# command does not see them, and so that a function does not run in place of a
# program of the same name.  The names of this script's functions are
# identifiers, so they need no quoting.  The `eval` expands the cronic_*
# variables before `unset` removes them.  If `unset` cannot remove one, such as
# one that BASH_ENV made readonly, then the subshell exits without running the
# command, and the report shows the error.  The `eval` then defines the caller's
# functions, which can replace a builtin, so the remaining commands run via
# `builtin`.
#
# The last command of the `eval` restores the caller's options that this script
# changed.  Otherwise, if the caller exported SHELLOPTS, a bash script that
# reads an unset variable (as `/usr/bin/texi2dvi` does when /bin/sh is bash)
# would fail.  Of those options, only nounset is on here, so a single `set`
# command turns it off and turns on the caller's, so that the restoring is not
# traced.  The `:+` avoids a bare `-`, which has a special meaning to `set`.
#
# The redirections apply to the whole subshell, so that they also capture what
# it writes after the command finishes, such as the output of an EXIT trap that
# the command sets.
#
# The subshell is not the operand of `||` or the like, because then bash would
# ignore `set -e` throughout the subshell, including in a shell function that it
# runs, and would remove "errexit" from the SHELLOPTS that the command inherits.
#
# Limitation:  if the command is a builtin that runs code in the subshell, such
# as `source` or `eval`, that code runs with the caller's options even if the
# caller does not export SHELLOPTS.  So if the caller does not use `set -u`,
# that code silently expands an unset variable to the empty string.
set +e
(
  # shellcheck disable=SC2046  # each name is a separate argument.
  unset -f $(compgen -A function)
  eval "unset -v \"\${!cronic_@}\" || exit 1
    $cronic_caller_functions
    ${cronic_caller_function_names:+builtin export -f --$cronic_caller_function_names}
    builtin set +u${cronic_caller_flags:+ -$cronic_caller_flags}"
  "$@"
) > "$cronic_out" 2> "$cronic_trace"
cronic_result=$?
set -e

# Unsetting BASH_XTRACEFD also closes its file descriptor.
unset BASH_XTRACEFD

# With the caller's xtrace on, the first line of the trace file is the trace of
# the `"$@"` line above, which is this script's, not the command's, so it is
# removed.  (The `set` command before it is not traced.)  For a builtin
# COMMAND, such as `exit`, that line is the builtin's own trace.  If PS4
# contains a newline, then that trace spans several lines, of which only the
# first is removed.  A bash before 4.1 writes the trace to stderr, and that line
# is not removed from it.
if [ -n "${cronic_xtrace_fd-}" ] && [[ $cronic_caller_flags == *x* ]]; then
  sed 1d "$cronic_xtrace" > "$cronic_xtrace.reduced"
  cronic_xtrace=$cronic_xtrace.reduced
fi

# End stderr with a newline, if it is not empty.  `grep` ends its output with a
# newline, so without this, the filtered stderr would differ from the
# unfiltered stderr even when `grep` removed no line, and the report would
# show the same output twice.  The newline also keeps the last line of stderr
# off the line of the report's next heading.
if [ -s "$cronic_trace" ] && [ "$(tail -c 1 "$cronic_trace" | wc -l)" -eq 0 ]; then
  echo >> "$cronic_trace"
fi

# Prints a basic regular expression that matches its argument literally.
# The argument must not contain a backslash.
cronic_bre_quote() {
  printf '%s\n' "$1" | LC_ALL=C sed 's/[*.[^]/\\&/g'
}

# Prints a basic regular expression that matches the trace lines, for PS4, that
# a shell other than bash 4.1 or later writes to stderr.  Such a line starts
# with PS4 after expansion, with PS4's first character repeated once per level
# of nesting.  If PS4 contains a `$`, backquote, or backslash, then its
# expansion can differ from line to line, so nothing is printed:  any pattern
# for such a PS4 could also match, and hide, a real error.  Nothing is printed
# if PS4 contains a newline, either, because `grep` would treat each line of
# the pattern as a separate pattern.
cronic_trace_pattern() {
  case ${PS4-} in
    '' | *[\$\`\\]* | *$'\n'*) return ;;
  esac
  # In the C locale, a character is a byte.  The first character is a UTF-8
  # lead byte and its continuation bytes, or else a single byte, so that a
  # multibyte character is repeated as a whole, whatever the locale.
  local LC_ALL=C
  [[ $PS4 =~ ^([$'\xc0'-$'\xff'][$'\x80'-$'\xbf']*|.) ]]
  local first=${BASH_REMATCH[0]}
  local rest=${PS4#"$first"}
  # `\{1,\}` rather than GNU's `\+`, which is not a POSIX basic regular
  # expression.
  printf '^\\(%s\\)\\{1,\\}%s\n' "$(cronic_bre_quote "$first")" "$(cronic_bre_quote "$rest")"
}

# Each `grep` that reads the wrapped command's output uses `-a`, so that it
# treats the output as text even if it contains a NUL byte or a byte that is
# invalid in the locale.  Without `-a`, `grep` would treat such output as
# binary and print only a "Binary file ... matches" notice in place of the
# lines it selects, so that a real error could go unreported.
cronic_pattern=$(cronic_trace_pattern)
if [ -n "$cronic_pattern" ]; then
  # `|| [ $? -eq 1 ]` because `grep -v` exits with status 1 when it selects no
  # lines, which happens whenever stderr consists only of trace lines.  Without
  # it, `set -e` would abort the script here, before it produces its report,
  # and it would exit with status 1 rather than with the wrapped command's
  # status.  If `grep` fails (status 2), the unfiltered stderr is used, rather
  # than an empty or truncated file cronic_err that could hide an error.
  grep -a -v "$cronic_pattern" "$cronic_trace" > "$cronic_err" || [ $? -eq 1 ] || cronic_err=$cronic_trace
else
  cronic_err=$cronic_trace
fi

# Certain Unix programs send output to stderr even when a command is successful!
# For example, git does this, and the POSIX standard requires it for make.
# The full stderr output is shown, but file cronic_reduced_err is checked for
# emptiness below.
#
# GNU make names itself by the name it was invoked as, without the directory,
# such as `make`, `gmake`, `gnumake` (on macOS), or `mingw32-make`.  It quotes
# the directory as 'dir' from version 4.0, and as `dir' before then; macOS's
# /usr/bin/make is GNU make 3.81.
# TODO: Expand this.
#
# `|| [ $? -eq 1 ]` because `grep -v` exits with status 1 when it selects no
# lines.  If `grep` fails (status 2), the unreduced stderr is used.
grep -a -E -v \
  -e '^Everything up-to-date$' \
  -e '^[[:alnum:]_.-]*make(\[[0-9]+\])?: (Entering|Leaving) directory '"[\`']"'.*'"'"'$' \
  "$cronic_err" > "$cronic_reduced_err" || [ $? -eq 1 ] || cronic_reduced_err=$cronic_err

if [ $cronic_result -ne "$cronic_expected" ] || { [ $cronic_permitstderr -eq 0 ] && [ -s "$cronic_reduced_err" ]; }; then
  echo "Cronic detected failure or error output for the command:"
  echo "$@"
  echo
  if [[ $cronic_expected -eq 0 ]]; then
    if [[ $cronic_result -eq 0 ]]; then
      echo "RESULT CODE: $cronic_result  (success)"
    else
      echo "RESULT CODE: $cronic_result  (failure)"
    fi
  else
    echo "RESULT CODE: $cronic_result  (expected: $cronic_expected)"
  fi
  echo
  echo "ERROR OUTPUT:"
  cat "$cronic_err"
  echo
  if [ "$cronic_debug" != "true" ]; then
    if ! cmp -s "$cronic_err" "$cronic_reduced_err"; then
      echo "REDUCED ERROR OUTPUT:"
      cat "$cronic_reduced_err"
      echo
    fi
  fi
  echo "STANDARD OUTPUT:"
  cat "$cronic_out"
  if ! cmp -s "$cronic_trace" "$cronic_err"; then
    echo
    echo "TRACE-ERROR OUTPUT:"
    cat "$cronic_trace"
  fi
  if [ -s "$cronic_xtrace" ]; then
    echo
    echo "TRACE OUTPUT:"
    cat "$cronic_xtrace"
  fi
  if [ $cronic_duplicate_stderr -eq 1 ]; then
    echo
    echo "ERROR OUTPUT:"
    cat "$cronic_err"
  fi
  echo
  echo "END OF CRONIC OUTPUT."
fi

# The temporary files are removed by the EXIT trap.

exit $cronic_result
