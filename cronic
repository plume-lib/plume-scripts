#!/bin/bash

# Cronic v2 - cron job report wrapper
# Copyright 2007 Chuck Houpt
# Documentation at http://habilis.net/cronic/
# In brief:
#   Cronic is a small shim shell script for wrapping cron jobs so that cron
#   only sends email when an error has occurred. Cronic defines an error as
#   any non-trace error output or a non-zero result code. Cronic filters
#   Bash execution traces (or anything matching PS4) from the error output,
#   so jobs can be run with execution tracing to aid forensic
#   debugging. Apart from its options, Cronic simply executes its
#   arguments.
# Extended by Michael Ernst to add the --expected-status, --permit-stderr, and
# --duplicate-stderr options, which may be given in any order.
# The options are documented in function `cronic_help`; run `cronic --help`.
# Trace lines are filtered only if PS4 contains no `$`, backquote, or backslash.
# COMMAND runs in a subshell, with the caller's variables and shell options
# rather than this script's.
# This script runs under bash 3.2, which is /bin/bash on macOS, so it does not
# use later features such as `${name@a}`.

# The caller's state, as commands that restore it, before this script changes
# any of it for itself.  The wrapped command runs with the caller's state
# rather than this script's; see where it is run, below.
#  * The caller's exported variables and functions whose names start with
#    `cronic_`, which this script's own variables and functions would otherwise
#    hide.
#  * The caller's `set -o` shell options.  `set +o` reports `-e` and verbose as
#    off, because bash turns them off in a command substitution, so `$-`
#    supplies them.  This script changes no `shopt` option, so the command
#    inherits the caller's `shopt` options without any restoring.
# If the caller exported SHELLOPTS, then this script does not trace itself or
# echo its input:  that output would go to this script's stderr, and cron would
# send email for every run.  An exported `verbose` nonetheless echoes the lines
# of this script that bash reads before it reaches the `set +vx`.  Bash cannot
# tell whether xtrace came from SHELLOPTS or from the command line, so
# `bash -x cronic` traces this script only if SHELLOPTS is not exported.
# The redirection discards the trace of these commands.
{
  # `compgen -e` lists exported variables, and fails if there are none, in which
  # case `declare -p` with no names would print every variable.  The `if` makes
  # the status 0, as `errexit` requires.  `declare -F` marks an exported
  # function with `x`.  The command substitution keeps `names`, `flags`, and
  # `name` out of this script.
  cronic_caller_variables=$(
    if names=$(compgen -e cronic_); then
      # shellcheck disable=SC2086 # Each name is one word.
      declare -p $names
    fi
    declare -F | while read -r _ flags name; do
      case "$flags $name" in
        -*x*' 'cronic_*)
          declare -f "$name"
          echo "export -f $name"
          ;;
      esac
    done
  )
  # `$-` supplies errexit, verbose, and xtrace.  They come last, in one
  # command, so that restoring verbose and xtrace neither echoes nor traces the
  # restoring of any other option.
  cronic_caller_options=$(set +o)
  cronic_caller_set='set'
  for cronic_option in e:errexit v:verbose x:xtrace; do
    cronic_caller_options=${cronic_caller_options/$'\n'set [-+]o ${cronic_option#*:}/}
    case $- in
      *"${cronic_option%%:*}"*) cronic_caller_set+=" -o ${cronic_option#*:}" ;;
      *) cronic_caller_set+=" +o ${cronic_option#*:}" ;;
    esac
  done
  cronic_caller_options+=$'\n'$cronic_caller_set
  if [[ $(declare -p SHELLOPTS) =~ ^declare\ -[a-zA-Z]*x ]]; then set +vx; fi
} 2> /dev/null

# Exit if a command exits with a non-zero status, and treat unset variables
# as an error.
set -eu

# Prints the usage line.
cronic_usage_line() {
  echo "Usage: $0 [--expected-status N] [--permit-stderr] [--duplicate-stderr] [--] COMMAND [ARG...]"
}

# Exits with status 64 (EX_USAGE in sysexits.h) rather than the conventional 2,
# because a wrapped command is much more likely to exit with status 2, and a
# caller that checks for a particular status should not mistake a misuse of
# this script for the command's own result.
cronic_usage() {
  cronic_usage_line >&2
  exit 64
}

# Prints a usage message to standard output and exits with status 0.
cronic_help() {
  cronic_usage_line
  echo "Runs COMMAND, and produces output only if it fails or writes to stderr."
  echo "  --expected-status N  treat exit status N (0 to 255), rather than 0, as success;"
  echo "                       may also be written --expected-status=N"
  echo "  --permit-stderr      do not treat error output as a failure"
  echo "  --duplicate-stderr   print the error output twice in the report, so that it"
  echo "                       is less likely to be overlooked"
  echo "  --                   end the options, so that COMMAND may start with \"-\""
  echo "  -h, --help           print this message"
  exit 0
}

# Sets cronic_expected to its argument, or reports a usage error if the
# argument is not a valid exit status.
cronic_set_expected() {
  cronic_expected=$1
  # No leading zeros, because `[[ ... -eq ... ]]` would read the value as
  # octal.  At most 255, because no exit status is larger.
  if ! [[ $cronic_expected =~ ^(0|[1-9][0-9]{0,2})$ ]] || [ "$cronic_expected" -gt 255 ]; then
    echo "$0: --expected-status requires an integer from 0 to 255, got \"$cronic_expected\"" >&2
    cronic_usage
  fi
}

# The options are parsed before the temporary directory is created, so that
# `--help` and a usage error neither create nor depend on it.
cronic_expected=0
cronic_permitstderr=0
cronic_duplicate_stderr=0
while [ $# -gt 0 ]; do
  case $1 in
    --expected-status)
      shift
      if [ $# -eq 0 ]; then
        echo "$0: --expected-status requires a value" >&2
        cronic_usage
      fi
      cronic_set_expected "$1"
      shift
      ;;
    --expected-status=*)
      cronic_set_expected "${1#*=}"
      shift
      ;;
    --permit-stderr)
      shift
      cronic_permitstderr=1
      ;;
    --duplicate-stderr)
      shift
      cronic_duplicate_stderr=1
      ;;
    -h | --help)
      cronic_help
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "$0: unknown option \"$1\"" >&2
      cronic_usage
      ;;
    *)
      break
      ;;
  esac
done
[ $# -gt 0 ] || cronic_usage

cronic_debug=false
# cronic_debug=true

# A private directory, rather than predictable `/tmp/cronic.*.$$` names: on a
# shared machine, process ids are guessable and reused, so another user could
# pre-create those paths as symlinks and have the wrapped command's output
# written through them.
cronic_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/cronic.XXXXXX") || exit 1
cronic_out=$cronic_tmpdir/out
cronic_err=$cronic_tmpdir/err
cronic_reduced_err=$cronic_tmpdir/err.reduced
cronic_trace=$cronic_tmpdir/trace

# Remove the temporary files however this script terminates, including when it
# is interrupted before it reaches the end.  When cronic_debug is true, the
# files are retained; don't "echo" their location, because that would be
# appended to stderr.
# shellcheck disable=SC2329  # the function is invoked from the trap handlers below.
cronic_cleanup() {
  [ "$cronic_debug" = "true" ] || rm -rf "$cronic_tmpdir"
}
trap cronic_cleanup EXIT

# Clean up and then die of the signal, rather than exiting with status
# 128+signum, so that a supervisor can distinguish "cronic was killed by
# SIGTERM" from "the wrapped command exited with status 143".  Each handler
# first removes itself and the EXIT trap, so that the cleanup runs exactly
# once.  These handlers are not redundant with the EXIT trap:  with no handler
# installed, bash dies as soon as the signal arrives, abandoning the wrapped
# command and deleting the directory that the command is still writing into,
# whereas a handler does not run until the wrapped command has finished.
trap 'cronic_cleanup; trap - HUP EXIT; kill -s HUP $$' HUP
trap 'cronic_cleanup; trap - INT EXIT; kill -s INT $$' INT
trap 'cronic_cleanup; trap - TERM EXIT; kill -s TERM $$' TERM

# Run the command with the caller's `set -o` shell options rather than this
# script's.  If the caller exported SHELLOPTS, then the command would otherwise
# inherit this script's options, and a bash script that reads an unset variable
# (as `/usr/bin/texi2dvi` does when /bin/sh is bash) would fail.
# The command runs in a subshell, rather than via `exec`, so that it can be a
# shell builtin or an exported shell function; and in a subshell rather than in
# this shell, so that a builtin such as `exit` or `exec` cannot end this script
# before it reports.  The subshell is not the left operand of `||`, because
# bash would then ignore `set -e` throughout the subshell, including in a
# shell function that it runs.  The redirections are on the subshell, so that
# when `-x` is set, the trace of running the command goes into the command's
# trace output rather than to this script's stderr.
# The subshell unsets every variable whose name starts with `cronic_` and every
# function whose name starts with `cronic_`, so that a builtin or shell function
# that is the command does not see this script's variables and functions, and
# so that a function does not take precedence over a program of the same name.
# Then the subshell restores the caller's variables and options.  The subshell
# first turns off this script's xtrace and verbose, so that the restoring is not
# traced or echoed; any error in the restoring goes to the command's error
# output.
set +e
(
  { set +vx; } 2> /dev/null
  eval "unset -v \"\${!cronic_@}\"
    unset -f \$(compgen -A function cronic_)
    $cronic_caller_variables
    $cronic_caller_options"
  "$@"
) > "$cronic_out" 2> "$cronic_trace"
cronic_result=$?
set -e

# A trace line starts with PS4 after expansion, with PS4's first character
# repeated once per level of nesting.  If PS4 contains a `$`, backquote, or
# backslash, then its expansion can differ from line to line, so no line is
# treated as a trace line:  any pattern for such a PS4 could also match, and
# hide, a real error.
# The `sed` command escapes PS4's basic-regular-expression metacharacters, then
# makes the first (possibly escaped) character repeatable.
cronic_pattern=
case ${PS4-} in
  '' | *[\$\`\\]*) ;;
  *)
    cronic_pattern=^$(printf '%s\n' "$PS4" | sed 's/[*.[^$]/\\&/g; s/^\\\{0,1\}./&\\+/')
    ;;
esac
if [ -n "$cronic_pattern" ] && grep -q "$cronic_pattern" "$cronic_trace"; then
  # `|| true` because `grep -v` exits with status 1 when it selects no lines,
  # which happens whenever stderr consists only of trace lines.  Without it,
  # `set -e` would abort the script here, before it produces its report,
  # exits with the wrapped command's status, and removes its temporary files.
  grep -v "$cronic_pattern" "$cronic_trace" > "$cronic_err" || true
else
  cronic_err=$cronic_trace
fi

# Certain Unix programs send output to stderr even when a command is successful!
# For example, git does this, and the POSIX standard requires it for make.
# The full stderr output is shown, but file cronic_reduced_err is checked for
# emptiness below.
# TODO: Expand this.
cat "$cronic_err" \
  | grep -v "^Everything up-to-date$" \
  | grep -v '^make\(\[[0-9]\+\]\)\?: \(Entering\|Leaving\) directory '"'"'.*'"'"'$' \
    > "$cronic_reduced_err" || true

if [ $cronic_result -ne "$cronic_expected" ] || { [ $cronic_permitstderr -eq 0 ] && [ -s "$cronic_reduced_err" ]; }; then
  echo "Cronic detected failure or error output for the command:"
  echo "$@"
  echo
  if [[ $cronic_expected -eq 0 ]]; then
    if [[ $cronic_result -eq 0 ]]; then
      echo "RESULT CODE: $cronic_result  (success)"
    else
      echo "RESULT CODE: $cronic_result  (failure)"
    fi
  else
    echo "RESULT CODE: $cronic_result  (expected: $cronic_expected)"
  fi
  echo
  echo "ERROR OUTPUT:"
  cat "$cronic_err"
  echo
  if [ "$cronic_debug" != "true" ]; then
    if ! cmp --silent "$cronic_err" "$cronic_reduced_err"; then
      echo "REDUCED ERROR OUTPUT:"
      cat "$cronic_reduced_err"
      echo
    fi
  fi
  echo "STANDARD OUTPUT:"
  cat "$cronic_out"
  if [ "$cronic_trace" != "$cronic_err" ]; then
    echo
    echo "TRACE-ERROR OUTPUT:"
    cat "$cronic_trace"
  fi
  if [ $cronic_duplicate_stderr -eq 1 ]; then
    echo
    echo "ERROR OUTPUT:"
    cat "$cronic_err"
  fi
  echo
  echo "END OF CRONIC OUTPUT."
fi

# The temporary files are removed by the EXIT trap.

exit $cronic_result
