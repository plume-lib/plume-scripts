#!/bin/bash

# Cronic v2 - cron job report wrapper
# Copyright 2007 Chuck Houpt
# Documentation at http://habilis.net/cronic/
# In brief:
#   Cronic is a small shim shell script for wrapping cron jobs so that cron
#   only sends email when an error has occurred. Cronic defines an error as
#   any non-trace error output or a non-zero result code. Cronic filters
#   Bash execution traces (or anything matching PS4) from the error output,
#   so jobs can be run with execution tracing to aid forensic
#   debugging. Cronic has no options, it simply executes its arguments.
# Extended by Michael Ernst to add --expected-status, --permit-stderr, and --duplicate-stderr flags.
# --duplicate-stderr prints stderr twice so that it is less likely to be overlooked.

# The caller's shell options, as commands that restore them, before this
# script changes any of them for itself.  The wrapped command runs with the
# caller's options rather than this script's; see where it is run, below.
# If the caller exported SHELLOPTS with xtrace, then this script does not trace
# itself:  the trace would go to this script's stderr, and cron would send
# email for every run.  `bash -x cronic` does not export SHELLOPTS, so it still
# traces this script.  The redirection discards the trace of these commands.
# `set +o` reports `-e` as off, because bash turns `-e` off in a command
# substitution, so `$-` supplies it.
{
  CRONIC_CALLER_OPTIONS=$(set +o)
  case $- in
    *e*) CRONIC_CALLER_OPTIONS=${CRONIC_CALLER_OPTIONS/set +o errexit/set -o errexit} ;;
  esac
  case ${SHELLOPTS@a} in *x*) set +x ;; esac
} 2> /dev/null

# Exit if a command exits with a non-zero status, and treat unset variables
# as an error.
set -eu

CRONIC_DEBUG=false
# CRONIC_DEBUG=true

# A private directory, rather than predictable `/tmp/cronic.*.$$` names: on a
# shared machine, process ids are guessable and reused, so another user could
# pre-create those paths as symlinks and have the wrapped command's output
# written through them.
CRONIC_TMPDIR=$(mktemp -d "${TMPDIR:-/tmp}/cronic.XXXXXX") || exit 1
CRONIC_OUT=$CRONIC_TMPDIR/out
CRONIC_ERR=$CRONIC_TMPDIR/err
CRONIC_REDUCED_ERR=$CRONIC_TMPDIR/err.reduced
CRONIC_TRACE=$CRONIC_TMPDIR/trace

# Remove the temporary files however this script terminates, including when it
# is interrupted before it reaches the end.  When CRONIC_DEBUG is true, the
# files are retained; don't "echo" their location, because that would be
# appended to stderr.
# shellcheck disable=SC2329  # the function is invoked from the trap handlers below.
cleanup() {
  [ "$CRONIC_DEBUG" = "true" ] || rm -rf "$CRONIC_TMPDIR"
}
trap cleanup EXIT

# Clean up and then die of the signal, rather than exiting with status
# 128+signum, so that a supervisor can distinguish "cronic was killed by
# SIGTERM" from "the wrapped command exited with status 143".  Each handler
# first removes itself and the EXIT trap, so that the cleanup runs exactly
# once.  These handlers are not redundant with the EXIT trap:  with no handler
# installed, bash dies as soon as the signal arrives, abandoning the wrapped
# command and deleting the directory that the command is still writing into,
# whereas a handler does not run until the wrapped command has finished.
trap 'cleanup; trap - HUP EXIT; kill -s HUP $$' HUP
trap 'cleanup; trap - INT EXIT; kill -s INT $$' INT
trap 'cleanup; trap - TERM EXIT; kill -s TERM $$' TERM

CRONIC_EXPECTED=0
if [ "$1" == "--expected-status" ]; then
  shift
  CRONIC_EXPECTED=$1
  shift
fi
CRONIC_PERMITSTDERR=0
if [ "$1" == "--permit-stderr" ]; then
  shift
  CRONIC_PERMITSTDERR=1
fi
CRONIC_DUPLICATE_STDERR=0
if [ "$1" == "--duplicate-stderr" ]; then
  shift
  CRONIC_DUPLICATE_STDERR=1
fi

# Run the command with all of the caller's shell options rather than this
# script's.  If the caller exported SHELLOPTS, then the command would otherwise
# inherit this script's options, and a bash script that reads an unset variable
# (as `/usr/bin/texi2dvi` does when /bin/sh is bash) would fail.
# The command runs in a subshell, rather than via `exec`, so that it can be a
# shell builtin or an exported shell function; and in a subshell rather than in
# this shell, so that a builtin such as `exit` or `exec` cannot end this script
# before it reports.  The subshell is not the left operand of `||`, because
# bash would then ignore `set -e` throughout the subshell, including in a
# shell function that it runs.  The redirections are on the subshell, so that
# when `-x` is set, the trace of running the command goes into the command's
# trace output rather than to this script's stderr.
# The subshell unsets every variable that this script has set, so that a
# builtin or shell function that is the command does not see them.  The
# `unset` runs within the `eval`, whose argument is expanded first; the
# `unset` thus precedes the restoring of the caller's `-x` and is not traced.
set +e
(
  eval "unset -v CRONIC_CALLER_OPTIONS CRONIC_DEBUG CRONIC_TMPDIR CRONIC_OUT \
    CRONIC_ERR CRONIC_REDUCED_ERR CRONIC_TRACE CRONIC_EXPECTED \
    CRONIC_PERMITSTDERR CRONIC_DUPLICATE_STDERR
    $CRONIC_CALLER_OPTIONS"
  "$@"
) > "$CRONIC_OUT" 2> "$CRONIC_TRACE"
RESULT=$?
set -e

PATTERN="^${PS4:0:1}\\+${PS4:1}"
if grep -q "$PATTERN" "$CRONIC_TRACE"; then
  # `|| true` because `grep -v` exits with status 1 when it selects no lines,
  # which happens whenever stderr consists only of trace lines.  Without it,
  # `set -e` would abort the script here, before it produces its report,
  # exits with the wrapped command's status, and removes its temporary files.
  grep -v "$PATTERN" "$CRONIC_TRACE" > "$CRONIC_ERR" || true
else
  CRONIC_ERR=$CRONIC_TRACE
fi

# Certain Unix programs send output to stderr even when a command is successful!
# For example, git does this, and the POSIX standard requires it for make.
# The full stderr output is shown, but file CRONIC_REDUCED_ERR is checked for emptiness below.
# TODO: Expand this.
cat "$CRONIC_ERR" \
  | grep -v "^Everything up-to-date$" \
  | grep -v '^make\(\[[0-9]\+\]\)\?: \(Entering\|Leaving\) directory '"'"'.*'"'"'$' \
    > "$CRONIC_REDUCED_ERR" || true

if [ $RESULT -ne "$CRONIC_EXPECTED" ] || { [ $CRONIC_PERMITSTDERR -eq 0 ] && [ -s "$CRONIC_REDUCED_ERR" ]; }; then
  echo "Cronic detected failure or error output for the command:"
  echo "$@"
  echo
  if [[ $CRONIC_EXPECTED -eq 0 ]]; then
    if [[ $RESULT -eq 0 ]]; then
      echo "RESULT CODE: $RESULT  (success)"
    else
      echo "RESULT CODE: $RESULT  (failure)"
    fi
  else
    echo "RESULT CODE: $RESULT  (expected: $CRONIC_EXPECTED)"
  fi
  echo
  echo "ERROR OUTPUT:"
  cat "$CRONIC_ERR"
  echo
  if [ "$CRONIC_DEBUG" != "true" ]; then
    if ! cmp --silent "$CRONIC_ERR" "$CRONIC_REDUCED_ERR"; then
      echo "REDUCED ERROR OUTPUT:"
      cat "$CRONIC_REDUCED_ERR"
      echo
    fi
  fi
  echo "STANDARD OUTPUT:"
  cat "$CRONIC_OUT"
  if [ "$CRONIC_TRACE" != "$CRONIC_ERR" ]; then
    echo
    echo "TRACE-ERROR OUTPUT:"
    cat "$CRONIC_TRACE"
  fi
  if [ $CRONIC_DUPLICATE_STDERR -eq 1 ]; then
    echo
    echo "ERROR OUTPUT:"
    cat "$CRONIC_ERR"
  fi
  echo
  echo "END OF CRONIC OUTPUT."
fi

# The temporary files are removed by the EXIT trap.

exit $RESULT
