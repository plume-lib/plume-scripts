#!/bin/sh

# Outputs the GitHub organization and branch for a CI job.  Other information about
# the CI job can be computed, but it is beyond the scope of this simple script.
# Works under Azure Pipelines, CircleCI, GitHub Actions, and Travis CI.
#
# The client `eval`s this script's output.  Script
# `set-ci-org-and-branch` computes the same information, but the
# client sources it.  Prefer to use `set-ci-org-and-branch` instead.

# Typical use:
#
#   PLUME_SCRIPTS="/tmp/${USER:-$(id -un)}/plume-scripts"
#   if [ -d "$PLUME_SCRIPTS" ] ; then
#     git -C "$PLUME_SCRIPTS" pull -q > /dev/null 2>&1
#   else
#     mkdir -p "$PLUME_SCRIPTS" \
#       && git clone --depth=1 -q https://github.com/plume-lib/plume-scripts.git "$PLUME_SCRIPTS"
#   fi
#   eval "$("$PLUME_SCRIPTS"/ci-org-and-branch DEFAULT-ORGANIZATION)"
#
# Alternatively, to use a specific version of this script rather than the latest:
#
#   PLUME_SCRIPTS="/tmp/${USER:-$(id -un)}/plume-scripts"
#   if [ ! -d "$PLUME_SCRIPTS" ] ; then
#     mkdir -p "$PLUME_SCRIPTS" \
#       && git clone --revision=e768754ffafad4a9f1e26c5305591d4061d890b4 --depth=1 -q https://github.com/plume-lib/plume-scripts.git "$PLUME_SCRIPTS"
#   fi
#   eval "$("$PLUME_SCRIPTS"/ci-org-and-branch DEFAULT-ORGANIZATION)"

# Optional argument DEFAULT-ORGANIZATION is used if no organization can be
# determined; variable CI_DEFAULT_ORGANIZATION is used if it is not supplied.

# Either snippet of code sets these variables:
# CI_ORGANIZATION: The GitHub organization.  In a PR, refers to the source or head.
# CI_BRANCH: The name of the source/head branch (in a PR) or of the branch being tested.
#
# Diagnostics requested by --verbose or --debug are written to standard error,
# so that only the variable settings appear on standard output.

# Requires the `jq` program, either `curl` or `wget`, and the scripts
# `eval-wrapper.sh` and `set-ci-org-and-branch` in the same directory as this
# script.
#
# If environment variable GITHUB_PAT or GH_TOKEN is set when this script is
# called, it is used as GitHub Personal Access Token when making GitHub API
# calls.  This can avoid "403 rate limit exceeded" failures.

# Alternatives:  The gradle-git-properties plugin automatically detects branch
# names from various CI environments.

_ew_script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
_ew_helper="set-ci-org-and-branch"
_ew_variables="CI_ORGANIZATION CI_BRANCH"
# `eval-wrapper.sh` parses the arguments, runs `set-ci-org-and-branch`, and
# prints the variables.  `git-changes` shares it, so that the two scripts
# cannot drift apart.
#
# `.` on a file that does not exist is an error in a special builtin, so the
# shell aborts at once, without running anything below and without writing
# anything on standard output.  The client's `eval` would then succeed, with no
# value (or a stale value) for each variable -- the silent success that the
# `exit` commands in `eval-wrapper.sh` exist to prevent.  A client that copies
# individual scripts rather than cloning this repository can easily be missing
# this one, because it is new.
if [ ! -f "${_ew_script_dir}/eval-wrapper.sh" ] || [ ! -r "${_ew_script_dir}/eval-wrapper.sh" ]; then
  echo "exit 2"
  echo "$0: cannot read ${_ew_script_dir}/eval-wrapper.sh" >&2
  exit 2
fi
# shellcheck source=eval-wrapper.sh
. "${_ew_script_dir}"/eval-wrapper.sh
