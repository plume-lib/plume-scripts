    CI_COMMIT_RANGE_START=$(git rev-parse "origin/$DEFAULT_BRANCH_NAME")
  fi
  CI_COMMIT_RANGE_END=$BUILD_SOURCEVERSION
  CI_COMMIT_RANGE=${CI_COMMIT_RANGE_START}...${CI_COMMIT_RANGE_END}
elif [ "$TRAVIS" = "true" ]; then
  ## Travis CI
  if [ "$DEBUG" = "--debug" ]; then
    emit_echo "Travis CI $TRAVIS"
  fi
  CI_BRANCH=${TRAVIS_PULL_REQUEST_BRANCH:-$TRAVIS_BRANCH}
  if [ "$VERBOSE" = "--verbose" ]; then
    emit_echo "TRAVIS_PULL_REQUEST_BRANCH=$TRAVIS_PULL_REQUEST_BRANCH"
    emit_echo "TRAVIS_BRANCH=$TRAVIS_BRANCH"
    emit_echo "CI_BRANCH=$CI_BRANCH"
  fi
  # $TRAVIS_COMMIT_RANGE is empty for builds triggered by the initial commit of a new branch.
  CI_COMMIT_RANGE=$TRAVIS_COMMIT_RANGE

elif [ -n "$CIRCLECI" ]; then
  if [ "$DEBUG" = "--debug" ]; then
    emit_echo "CircleCI, CIRCLE_PULL_REQUEST=$CIRCLE_PULL_REQUEST"
  fi
  if [ -n "$CIRCLE_PR_NUMBER" ]; then
    # TODO: Can I implement this without a GitHub API request?
    # The request is unauthenticated, so it is subject to throttling; every
    # value it provides has a fallback that is computed locally.
    url="https://api.github.com/repos/${CIRCLE_PROJECT_USERNAME}/${CIRCLE_PROJECT_REPONAME}/pulls/${CIRCLE_PR_NUMBER}"
    pull_json="$(get_url "${url}" | tr -d '[:cntrl:]')"
    # "// empty" maps JSON null to the empty string; the redirection discards
    # jq's complaint if the response is not JSON at all (as when throttling
    # yields an HTML error page).
    CI_BRANCH=$(printf '%s' "${pull_json}" | jq -r '.head.ref // empty' 2> /dev/null)
    CI_COMMIT_RANGE_START=$(printf '%s' "${pull_json}" | jq -r '.base.sha // empty' 2> /dev/null)
    CI_COMMIT_RANGE_END=$(printf '%s' "${pull_json}" | jq -r '.head.sha // empty' 2> /dev/null)
    # The branch that the pull request is against.  It is usually the default
    # branch, but a pull request may be against any branch.
    base_branch=$(printf '%s' "${pull_json}" | jq -r '.base.ref // empty' 2> /dev/null)
    if [ -z "$base_branch" ]; then
      base_branch=$DEFAULT_BRANCH_NAME
    fi
    if [ -z "$CI_BRANCH" ]; then
      # For a pull request, this is like "pull/1234" rather than a branch name.
      CI_BRANCH=$CIRCLE_BRANCH
    fi
    if [ -z "$CI_COMMIT_RANGE_END" ] \
      || ! git rev-parse --verify -q "${CI_COMMIT_RANGE_END}^{commit}" > /dev/null; then
      # Either the GitHub API request supplied no head commit, or it supplied
      # one that is not in this clone (as happens when the pull request branch
      # was pushed to after this job checked it out).  Use the commit that this
      # job is actually testing.
      CI_COMMIT_RANGE_END=${CIRCLE_SHA1:-$(git rev-parse HEAD)}
    fi

    if [ -n "$CI_COMMIT_RANGE_START" ] && ! commit_range_is_usable; then
      # Fetch the branch that the commit is on.  Fetching by commit ID would be
      # cheaper, but not every server permits it; `git fetch --depth` would be
      # futile, because the commit is on a branch that this clone may not track
      # at all, and it would shorten a complete clone's history.
      fetch_base_branch
      if ! commit_range_is_usable; then
        if git rev-parse --verify -q "${CI_COMMIT_RANGE_START}^{commit}" > /dev/null; then
          # The commit is here, but this clone's history stops after the fork
          # point.  Completing the clone is the only way to reach it.
          unshallow
        fi
        if ! commit_range_is_usable; then
          # The commit is unreachable in origin, as after a force-push, so no
          # amount of fetching will produce it.
          emit_echo "${SCRIPT_NAME}: cannot use commit range start ${CI_COMMIT_RANGE_START} from the GitHub API."
          CI_COMMIT_RANGE_START=""
        fi
      fi
    fi

    if [ -z "$CI_COMMIT_RANGE_START" ]; then
      # Either the GitHub API request failed, or its answer is unusable.  Use
      # the fork point from the base branch instead.  Say so, because otherwise
      # the log gives no way to tell which of the two was used.
      emit_echo "${SCRIPT_NAME}: computing commit range start locally, as the fork point from ${base_branch:-the default branch}."
      fetch_base_branch
      if [ -n "$base_tip" ]; then
        CI_COMMIT_RANGE_START=$(git merge-base "$base_tip" "$CI_COMMIT_RANGE_END" 2> /dev/null)
        if [ -z "$CI_COMMIT_RANGE_START" ]; then
          # In a shallow clone, `git merge-base` either gives the right answer
          # or no answer, so completing the clone is needed only now.  The base
          # branch does not need to be fetched again; only this clone's own
          # history was missing.
          unshallow
          CI_COMMIT_RANGE_START=$(git merge-base "$base_tip" "$CI_COMMIT_RANGE_END" 2> /dev/null)
        fi
      fi
      if [ -z "$CI_COMMIT_RANGE_START" ]; then
        # Last resort.  Under CircleCI, HEAD is the pull request's head branch,
        # so HEAD^1 is the pull request's next-to-last commit and the range
        # omits every earlier commit of the pull request.  Warn, because the
        # range is valid and non-empty, so no client will complain about it.
        CI_COMMIT_RANGE_START=$(head1)
        emit_echo "${SCRIPT_NAME}: WARNING: cannot find the fork point from ${base_branch:-the default branch}, so the commit range covers only the last commit."
      fi
    fi
    CI_COMMIT_RANGE="${CI_COMMIT_RANGE_START}...${CI_COMMIT_RANGE_END}"
  else
    CI_BRANCH=$CIRCLE_BRANCH
  fi

elif [ -n "${GITHUB_HEAD_REF}" ]; then
  # GitHub Actions pull request (no special handling is required for non-PR GitHub Actions jobs).
  if [ "$DEBUG" = "--debug" ]; then
    emit_echo "GitHub Actions pull request https://github.com/${GITHUB_REPOSITORY}/pull/${GITHUB_PR_NUMBER}"
    emit_echo "  GITHUB_BASE_REF=${GITHUB_BASE_REF}"
    emit_echo "  GITHUB_REF_NAME=${GITHUB_REF_NAME}"
    emit_echo "  GITHUB_SHA=${GITHUB_SHA}"
    # GITHUB_HEAD_REF is in the PR fork which is not available.
    emit_echo "  GITHUB_HEAD_REF=${GITHUB_HEAD_REF}"
  fi
  # At this point, these two are the same:
  # git rev-parse HEAD
  # git rev-parse remotes/pull/"${GITHUB_REF_NAME}"

  GITHUB_PR_NUMBER=${GITHUB_REF_NAME%/merge}

  CI_BRANCH="${GITHUB_HEAD_REF}"
  if ! CI_COMMIT_RANGE_START=$(git rev-parse "${GITHUB_BASE_REF}" 2> /dev/null); then
    if ! CI_COMMIT_RANGE_START=$(git rev-parse remotes/origin/"${GITHUB_BASE_REF}" 2> /dev/null); then
      if ! CI_COMMIT_RANGE_START=$(git rev-parse refs/remotes/origin/"${GITHUB_BASE_REF}" 2> /dev/null); then
        if ! CI_COMMIT_RANGE_START=$(git rev-parse refs/remotes/origin/"${DEFAULT_BRANCH_NAME}" 2> /dev/null); then
          pull_json="$(get_url "https://api.github.com/repos/${GITHUB_REPOSITORY}/pulls/${GITHUB_PR_NUMBER}" | tr -d '[:cntrl:]')"
          if ! CI_COMMIT_RANGE_START=$(printf '%s' "${pull_json}" | jq -e -r '.base.sha // empty'); then
            emit_echo "${SCRIPT_NAME} in $(pwd): cannot find commit range start, tried ${GITHUB_BASE_REF} and remotes/origin/${GITHUB_BASE_REF} and refs/remotes/origin/${GITHUB_BASE_REF} and refs/remotes/origin/${DEFAULT_BRANCH_NAME}"
            # This is a routine failure in a shallow single-branch checkout,
            # so dump the state only when asked.  `set` prints the whole
            # environment, and CI logs are often readable by anyone who can
            # see the job.
            if [ "$DEBUG" = "--debug" ]; then
              emit_echo '---------------- start of set'
              set | redact_tokens | emit_echo_lines
              emit_echo '---------------- end of set'
              # emit_echo "git branch:"
              # git --no-pager branch -a | cut -c 3- | emit_echo_lines
              emit_echo "git log --graph:"
              git log --graph | head --lines=1000 | emit_echo_lines
              emit_echo "git show:"
              git --no-pager show | head --lines=1000 | emit_echo_lines
            fi
            CI_COMMIT_RANGE_START=$(git rev-parse "${GITHUB_SHA}"^)
            # emit_echo "exiting"
            # # exit 2
            # exit
          fi
        fi
      fi
    fi
  fi
  # These are the same: `sha`=`echo $GITHUB_SHA`=`git rev-parse remotes/pull/"${GITHUB_REF_NAME}"`.
  CI_COMMIT_RANGE_END=${GITHUB_SHA}
  CI_COMMIT_RANGE="${CI_COMMIT_RANGE_START}...${CI_COMMIT_RANGE_END}"

  # If this elif is reached, it's not a pull request (except maybe a re-run Azure Pipelines pull request).
elif [ -n "$GITHUB_ACTIONS" ]; then
  # GitHub Actions, non-pull-request.
  if [ "$DEBUG" = "--debug" ]; then
    emit_echo "GitHub Actions, not a pull request, GITHUB_REF_NAME=${GITHUB_REF_NAME}, GITHUB_SHA=${GITHUB_SHA}, head=$(git rev-parse HEAD)"
  fi

  if [ "${GITHUB_EVENT_NAME}" = "pull_request" ]; then
    emit_echo "GITHUB_EVENT_NAME=${GITHUB_EVENT_NAME}"
    emit_exit 2
  fi

  # GITHUB_REF_NAME is the name of the branch or tag being built, except in a
  # pull request, where it is like "40/merge" and names no branch.  Tell the
  # two apart by the ref name's syntax.  Don't instead ask `git branch --list`
  # whether the name is a local branch:  a job that checked out a detached HEAD
  # or a different `ref` has no local branch of that name either, and then a
  # branch or tag name would be used as a pull request number, giving a 404 and
  # an empty CI_BRANCH.
  pr_number=""
  case "${GITHUB_REF_NAME}" in
    */merge)
      # A pull request number is a nonempty string of digits.  A branch may be
      # named "release/merge", which is not a pull request.
      case "${GITHUB_REF_NAME%/merge}" in
        '' | *[!0-9]*) ;;
        *) pr_number="${GITHUB_REF_NAME%/merge}" ;;
      esac
      ;;
  esac
  if [ -z "$pr_number" ]; then
    CI_BRANCH="${GITHUB_REF_NAME}"
  else
    # TODO: Can I implement this without a GitHub API request?
    url="https://api.github.com/repos/${GITHUB_REPOSITORY}/pulls/${pr_number}"
    pull_json="$(get_url "${url}" | tr -d '[:cntrl:]')"
    CI_BRANCH=$(printf '%s' "${pull_json}" | jq -r '.head.ref // empty' 2> /dev/null)
  fi
  CI_COMMIT_RANGE_END="${GITHUB_SHA}"

else

  if [ "$DEBUG" = "--debug" ]; then
    emit_echo "Else clause: no CI environment detected"
  fi
  # git 2.22 and later has `git branch --show-current`; CircleCI doesn't have that version yet.
  CI_BRANCH=$(git rev-parse --abbrev-ref HEAD)
  # In an Azure Pipelines pull request, `git branch` yields "(HEAD detached at pull/4/merge)".
  # If you re-run a pull request via "Queue" rather than "Rebuild",
  # variables SYSTEM_PULLREQUEST_TARGETBRANCH and SYSTEM_PULLREQUEST_SOURCEBRANCH are not set.
  if [ "$CI_BRANCH" = '(HEAD' ]; then
    CI_BRANCH=$DEFAULT_BRANCH_NAME
  fi
fi

if [ "$DEBUG" = "--debug" ]; then
  emit_echo "CI_BRANCH=${CI_BRANCH}"
  emit_echo "CI_COMMIT_RANGE_START=${CI_COMMIT_RANGE_START}"
  emit_echo "CI_COMMIT_RANGE_END=${CI_COMMIT_RANGE_END}"
  emit_echo "CI_COMMIT_RANGE=${CI_COMMIT_RANGE}"
fi

## The above may not have set CI_COMMIT_RANGE.  Set it.

# Separate from "It's not a pull request" because sometimes this is not set for Travis.
if [ -z "$CI_COMMIT_RANGE" ]; then
  if [ "$DEBUG" = "--debug" ]; then
    emit_echo "Setting CI_COMMIT_RANGE from CI_BRANCH=$CI_BRANCH"
  fi
  if [ "$CI_BRANCH" = "$DEFAULT_BRANCH_NAME" ]; then
    if git show --summary HEAD | grep -q ^Merge:; then
      CI_COMMIT_RANGE_START=$(git merge-base HEAD^1 HEAD^2)
    else
      CI_COMMIT_RANGE_START=$(head1)
    fi
    CI_COMMIT_RANGE_END=$(git rev-parse HEAD)
  else
    # "origin/$DEFAULT_BRANCH_NAME" is accurate when the pull request was
    # created, but it doesn't change when force-push occurs (as Renovate does),
    # making it out of date.
    case $CI_BRANCH in
      renovate/*) CI_COMMIT_RANGE_START=$(head1) ;;
      *)
        if git rev-parse --verify --quiet "origin/$DEFAULT_BRANCH_NAME" > /dev/null 2>&1; then
          CI_COMMIT_RANGE_START=$(git rev-parse "origin/$DEFAULT_BRANCH_NAME")
          if [ "$DEBUG" = "--debug" ]; then
            emit_echo "Set CI_COMMIT_RANGE_START=$CI_COMMIT_RANGE_START from git rev-parse origin/$DEFAULT_BRANCH_NAME"
          fi
        else
          if git show --summary HEAD | grep -q ^Merge:; then
            CI_COMMIT_RANGE_START=$(git merge-base HEAD^1 HEAD^2)
          else
            CI_COMMIT_RANGE_START=$(head1)
          fi
        fi
        ;;
    esac
    CI_COMMIT_RANGE_END=$(git rev-parse "$CI_BRANCH")
  fi
  CI_COMMIT_RANGE=${CI_COMMIT_RANGE_START}...${CI_COMMIT_RANGE_END}
  if [ "$DEBUG" = "--debug" ]; then
    emit_echo "CI_BRANCH=${CI_BRANCH}"
    emit_echo "CI_COMMIT_RANGE_START=${CI_COMMIT_RANGE_START}"
    emit_echo "CI_COMMIT_RANGE_END=${CI_COMMIT_RANGE_END}"
    emit_echo "CI_COMMIT_RANGE=${CI_COMMIT_RANGE}"
  fi
fi

if [ -z "$CI_COMMIT_RANGE_START" ]; then
  if [ "$DEBUG" = "--debug" ]; then
    emit_echo "Setting CI_COMMIT_RANGE_START from CI_COMMIT_RANGE=$CI_COMMIT_RANGE"
  fi
  CI_COMMIT_RANGE_START=${CI_COMMIT_RANGE%%.*}
  CI_COMMIT_RANGE_END=${CI_COMMIT_RANGE##*.}
  if [ -z "$CI_COMMIT_RANGE_START" ]; then
    CI_COMMIT_RANGE_START=${CI_COMMIT_RANGE_END}
  fi
fi

# Avoid errors regarding empty range
if [ "$CI_COMMIT_RANGE_START" = "$CI_COMMIT_RANGE_END" ]; then
  if [ "$VERBOSE" = "--verbose" ]; then
    emit_echo "Resetting CI_COMMIT_RANGE_START because CI_COMMIT_RANGE=$CI_COMMIT_RANGE"
  fi
  if git show --summary "$CI_COMMIT_RANGE_END" | grep -q ^Merge:; then
    CI_COMMIT_RANGE_START=$(git merge-base "$CI_COMMIT_RANGE_END^1" "$CI_COMMIT_RANGE_END^2")
  else
    if git rev-parse --verify --quiet "$CI_COMMIT_RANGE_END^1" > /dev/null 2>&1; then
      CI_COMMIT_RANGE_START=$(git rev-parse "$CI_COMMIT_RANGE_END^1")
    fi
  fi
  # The start and end commits could still be the same, if the current branch was cloned with
  # --depth=1.
  CI_COMMIT_RANGE="${CI_COMMIT_RANGE_START}...${CI_COMMIT_RANGE_END}"
fi

if [ "$VERBOSE" = "--verbose" ]; then
  # A throttled or otherwise failed request also has a non-empty response body,
  # so test whether the response really does describe a pull request.
  if [ -n "${pull_json}" ] \
    && printf '%s' "${pull_json}" | jq -e -r '.head.sha // empty' > /dev/null 2>&1; then
    emit_echo "CI_ACCESSED_GITHUB_API=true"
  else
    emit_echo "CI_ACCESSED_GITHUB_API=false"
  fi
fi

if [ "$VERBOSE" = "--verbose" ]; then
  emit_echo '---------------- start of first 10000 lines of diff:'
  git --no-pager diff "${CI_COMMIT_RANGE}" | head --lines=10000 | emit_echo_lines
  emit_echo '---------------- end of first 10000 lines of diff.'
fi

# The diff might be empty if the last commit is the revert of the one before it.

### Print it out

if [ "$VERBOSE" = "--verbose" ]; then
  emit_echo "CI_ORGANIZATION=$CI_ORGANIZATION"
fi
echo "CI_ORGANIZATION=$(shell_quote "$CI_ORGANIZATION"); export CI_ORGANIZATION;"
if [ "$VERBOSE" = "--verbose" ]; then
  emit_echo "CI_BRANCH=$CI_BRANCH"
fi
echo "CI_BRANCH=$(shell_quote "$CI_BRANCH"); export CI_BRANCH;"
if [ "$VERBOSE" = "--verbose" ]; then
  emit_echo "CI_COMMIT_RANGE_START=$CI_COMMIT_RANGE_START"
fi
echo "CI_COMMIT_RANGE_START=$(shell_quote "$CI_COMMIT_RANGE_START"); export CI_COMMIT_RANGE_START;"
if [ "$VERBOSE" = "--verbose" ]; then
  emit_echo "CI_COMMIT_RANGE_END=$CI_COMMIT_RANGE_END"
fi
echo "CI_COMMIT_RANGE_END=$(shell_quote "$CI_COMMIT_RANGE_END"); export CI_COMMIT_RANGE_END;"
if [ "$VERBOSE" = "--verbose" ]; then
  emit_echo "CI_COMMIT_RANGE=$CI_COMMIT_RANGE"
fi
echo "CI_COMMIT_RANGE=$(shell_quote "$CI_COMMIT_RANGE"); export CI_COMMIT_RANGE;"
