#!/bin/sh

# This script is obsolete.  Use `ci-org-and-branch` and `git-changes` instead.
#
# This script duplicates what `set-ci-org-and-branch` and `set-git-range` do.
# The duplication is deliberate:  this script is frozen except for bug fixes,
# so extracting the shared code into a file that both it and the "set-" scripts
# source would constrain those scripts for the sake of a script that no one
# should be using.  Keep a bug fix in step across the copies, and prefer the
# "set-" scripts' behavior where they differ, as they do in two places:
#  * When the GitHub API request for an Azure Pipelines pull request fails,
#    this script gives up; `set-ci-org-and-branch` falls back to
#    $SYSTEM_PULLREQUEST_SOURCEREPOSITORYURI.
#  * This script derives the organization from the leading components of the
#    origin URL without checking that the URL names GitHub, so for a local or
#    non-GitHub origin it yields a fragment of a path rather than nothing.

# Determines the start and end commits for a CI job.
# Works under Azure Pipelines, CircleCI, GitHub Actions, and Travis CI.

# Typical use:
#
#   PLUME_SCRIPTS="/tmp/${USER:-$(id -un)}/plume-scripts"
#   if [ -d "$PLUME_SCRIPTS" ] ; then
#     git -C "$PLUME_SCRIPTS" pull -q > /dev/null 2>&1
#   else
#     git clone --depth=1 -q https://github.com/plume-lib/plume-scripts.git "$PLUME_SCRIPTS"
#   fi
#   eval "$("$PLUME_SCRIPTS"/ci-info DEFAULT-ORGANIZATION)"
#
# Alternatively, to use a specific version of this script rather than the latest:
#
#   PLUME_SCRIPTS="/tmp/${USER:-$(id -un)}/plume-scripts"
#   if [ ! -d "$PLUME_SCRIPTS" ] ; then
#     git clone --revision=e768754ffafad4a9f1e26c5305591d4061d890b4 --depth=1 -q https://github.com/plume-lib/plume-scripts.git "$PLUME_SCRIPTS"
#   fi
#   eval "$("$PLUME_SCRIPTS"/ci-info DEFAULT-ORGANIZATION)"

# Either snippet of code sets these variables:
# CI_COMMIT_RANGE: An argument to `git diff` with the range of commit IDs.
#    (Don't use it with `git log`, which interprets its argument differently.)
# CI_COMMIT_RANGE_START: The start element of CI_COMMIT_RANGE, a commit ID/SHA.
# CI_COMMIT_RANGE_END: The end element of CI_COMMIT_RANGE, a commit ID/SHA.
#
# If called not under CI, or under CI but not in the main or toplevel
# clone, then gets information from the local repository.

# Requires the `jq` program and either `curl` or `wget`.
#
# If environment variable GITHUB_PAT or GH_TOKEN is set when this script is
# called, it is used as GitHub Personal Access Token when making GitHub API
# calls.  This can avoid "403 rate limit exceeded" failures.

# PROBLEM: The directory from which git-changes is running must override environment
# variables, because a CI job may itself call "git clone" and then later call
# git-changes from that clone.  Idea: check the directory name.

# SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$0")"

# Writes its argument, quoted so that the client's `eval` reads it back as one
# word.  A value may contain a shell metacharacter:  a git branch name may
# contain any of `$`, backquote, `;`, `&`, `|`, and `'`.
shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# emit_echo TEXT: writes a command that prints TEXT when the client `eval`s
# this script's output.  TEXT is quoted, so a value interpolated into it is
# printed rather than executed.  Much of what this script reports -- a branch
# name, a GitHub API response -- is chosen by whoever opened the pull request
# being tested, so an unquoted value would be a command injection into the
# client.
emit_echo() {
  echo "echo $(shell_quote "$1");"
}

# Copies standard input to standard output, turning each line into a command
# that prints that line when the client `eval`s this script's output.  The
# quoting is as in `emit_echo`, and for the same reason.
emit_echo_lines() {
  sed -e "s/'/'\\\\''/g" -e "s/^/echo '/" -e "s/\$/';/"
}

# emit_exit STATUS: writes a command that makes the client's `eval` exit with
# STATUS, then exits with STATUS.  The client's `eval` reports the status of
# the text it evaluated rather than this script's, so exiting without writing
# that command would leave the client with status 0 and with no value (or a
# stale value) for each variable.  The client would then act on the silent
# success -- running, say, `git diff ${CI_COMMIT_RANGE}` with CI_COMMIT_RANGE
# unset, which diffs the working tree rather than the pull request.
emit_exit() {
  echo "exit $1"
  exit "$1"
}

DEBUG=""
DEFAULT_ORGANIZATION=""
while [ "$#" -gt 0 ]; do
  case $1 in
    --verbose)
      VERBOSE="--verbose"
      ;;
    --debug)
      DEBUG="--debug"
      VERBOSE="--verbose"
      ;;
    *)
      if [ -n "${DEFAULT_ORGANIZATION}" ]; then
        usage="Usage: ${SCRIPT_NAME} [--verbose] [--debug] [DEFAULT-ORGANIZATION]"
        emit_echo "$usage"
        echo "$usage" >&2
        emit_exit 2
      else
        DEFAULT_ORGANIZATION="$1"
      fi
      ;;
  esac
  shift
done

# Copies standard input to standard output, with the value of each variable
# whose name suggests a credential replaced.  A debug dump would otherwise
# write secrets into the CI log, which is often readable by anyone who can see
# the job.  Matching by name pattern rather than by an allowlist of names also
# covers secrets that this script does not know about; GitHub Actions, for
# example, defines $ACTIONS_RUNTIME_TOKEN in every job and does not mask it.
# The placeholder contains no shell metacharacters, because the client `eval`s
# this script's output.
# This function is defined here rather than with the other functions below,
# because the debug dump just after it uses it.
redact_tokens() {
  awk '
    /^[A-Za-z_][A-Za-z0-9_]*=/ {
      name = $0
      sub(/=.*/, "", name)
      if (toupper(name) ~ /TOKEN|SECRET|PASSWORD|PASSWD|PASSPHRASE|CREDENTIAL|APIKEY|API_KEY|PRIVATE_KEY|_PAT$|^PAT$/) {
        print name "=REDACTED"
        next
      }
    }
    { print }
  '
}

if [ "$DEBUG" = "--debug" ]; then
  # `env` only prints EXPORTED variables, so `set` is usually more useful.
  emit_echo "${SCRIPT_NAME} is running in $(pwd)"
  echo
  emit_echo '---------------- start of env'
  env -0 | sort -z | tr '\0' '\n' | redact_tokens | emit_echo_lines
  emit_echo '---------------- end of env'
  echo
  emit_echo '---------------- start of set'
  set | redact_tokens | emit_echo_lines
  emit_echo '---------------- end of set'
  echo
  emit_echo '---------------- start of git status'
  git --no-pager status | emit_echo_lines
  emit_echo '---------------- end of git status'
  echo
  emit_echo '---------------- start of all branches'
  git --no-pager branch -a | emit_echo_lines
  emit_echo '---------------- end of all branches'
  echo
  emit_echo '---------------- start of all remote branches'
  git --no-pager branch -r | emit_echo_lines
  emit_echo '---------------- end of all branches'
  echo
  emit_echo '---------------- start of 1000 lines of git log'
  git --no-pager log --graph | head --lines=1000 | emit_echo_lines
  emit_echo '---------------- end of 1000 lines of git log'
  echo
fi

### Variables

# "GITHUB_PAT" is a GitHub Personal Access Token.
# TODO: Should this be "Authorization: Bearer <YOUR-TOKEN>" instead?  See https://docs.github.com/en/rest/pulls/pulls#get-a-pull-request
if [ -n "$GITHUB_PAT" ]; then
  auth_token="$GITHUB_PAT"
elif [ -n "$GH_TOKEN" ]; then
  auth_token="$GH_TOKEN"
else
  auth_token=""
fi

### Prerequisites

# TODO: Try to not access the GitHub REST API, because it can get throttled.
if [ -n "$(command -v curl 2> /dev/null)" ]; then
  http_get_tool="curl"
elif [ -n "$(command -v wget 2> /dev/null)" ]; then
  http_get_tool="wget"
else
  emit_echo "Neither curl nor wget is installed"
  emit_exit 2
fi

# get_url URL: fetch URL to standard output, sending an Authorization header
# if $auth_token is set.  The header is passed as a single argument rather than
# being word-split out of a command string; that avoids mangling the header and
# leaking the token into stray connection attempts.
get_url() {
  if [ "$http_get_tool" = "curl" ]; then
    if [ -n "$auth_token" ]; then
      curl -s --header "Authorization: token $auth_token" "$1"
    else
      curl -s "$1"
    fi
  else
    if [ -n "$auth_token" ]; then
      wget -q -O - --header="Authorization: token $auth_token" "$1"
    else
      wget -q -O - "$1"
    fi
  fi
}

if [ -z "$(command -v jq 2> /dev/null)" ]; then
  emit_echo "jq is not installed"
  emit_exit 2
fi

### Functions

# Returns either `git rev-parse HEAD^1` if HEAD^1 exists, or `git rev-parse HEAD`.
# HEAD^1 does not exist if the clone was created with `git clone --depth=1`.
head1() {
  if git rev-parse --verify --quiet HEAD^1 > /dev/null 2>&1; then
    git rev-parse HEAD^1
  else
    git rev-parse HEAD
  fi
}

# Converts a shallow clone into a complete one.
unshallow() {
  if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
    git fetch --unshallow origin
  fi
}

# Fetches $base_branch, the branch that a pull request is against, and sets
# $base_tip to its commit.  Does nothing on a second call, because fetching a
# branch fetches its complete history, so once is enough.
base_branch=""
base_branch_fetched=""
base_tip=""
fetch_base_branch() {
  if [ -z "$base_branch_fetched" ] && [ -n "$base_branch" ]; then
    base_branch_fetched="true"
    # Test the fetch's status rather than reading FETCH_HEAD unconditionally:  a
    # fetch that fails before writing FETCH_HEAD (as when the network is down)
    # leaves the previous fetch's commit there, which would silently yield a
    # commit range computed from an unrelated branch.
    if git fetch -q origin "$base_branch"; then
      # Remember the tip, because a later fetch overwrites FETCH_HEAD.
      base_tip=$(git rev-parse --verify -q FETCH_HEAD)
    else
      emit_echo "${SCRIPT_NAME}: cannot fetch ${base_branch} from origin."
    fi
  fi
}

# Returns true if `git diff ${CI_COMMIT_RANGE_START}...${CI_COMMIT_RANGE_END}`
# would work.  That command diffs from the merge base of the two commits, so it
# is not enough for both commits to be in the clone; their common ancestor must
# be as well, which is not the case in a clone that is too shallow.
commit_range_is_usable() {
  git merge-base "$CI_COMMIT_RANGE_START" "$CI_COMMIT_RANGE_END" > /dev/null 2>&1
}

### Organization

## Continuous integration services
if [ "$TRAVIS" = "true" ]; then
  CI_ORGANIZATION=${TRAVIS_PULL_REQUEST_SLUG%/*}
  if [ -z "$CI_ORGANIZATION" ]; then
    CI_ORGANIZATION=${TRAVIS_REPO_SLUG%/*}
  fi
elif [ -n "$AZURE_HTTP_USER_AGENT" ]; then
  # TODO: Can I implement this without a GitHub API request?
  if [ "$BUILD_REASON" = "PullRequest" ]; then
    url="https://api.github.com/repos/${BUILD_REPOSITORY_NAME}/pulls/${SYSTEM_PULLREQUEST_PULLREQUESTNUMBER}"
    pull_json="$(get_url "${url}" 2>&1 | tr -d '[:cntrl:]')"
    SLUG=$(printf '%s' "${pull_json}" | jq -r '.head.label // empty' 2> /dev/null)
    if [ -z "$SLUG" ]; then
      emit_echo "${SCRIPT_NAME} error: bad output for ${url}"
      if [ -n "$auth_token" ]; then
        emit_echo "auth_token is set."
      fi
      emit_echo "---- start of ${http_get_tool} output ----"
      printf '%s\n' "${pull_json}" | emit_echo_lines
      emit_echo "---- end of ${http_get_tool} output ----"
      emit_exit 2
    fi
    CI_ORGANIZATION=${SLUG%:*}
  else
    CI_ORGANIZATION=${BUILD_REPOSITORY_NAME%/*}
    # CI_REPO=${BUILD_REPOSITORY_NAME##*/}
  fi
elif [ -n "$CIRCLE_PR_USERNAME" ]; then
  CI_ORGANIZATION="$CIRCLE_PR_USERNAME"
elif [ -n "$GITHUB_HEAD_REF" ]; then
  # GitHub Actions pull request

  # TODO: Can I implement this without a GitHub API request?
  # Is GITHUB_ACTOR equal to CI_ORGANIZATION, maybe??  (Need to observe beyond mernst.)
  GITHUB_PR_NUMBER=${GITHUB_REF_NAME%/merge}
  url="https://api.github.com/repos/${GITHUB_REPOSITORY}/pulls/${GITHUB_PR_NUMBER}"
  pull_json="$(get_url "${url}" 2>&1 | tr -d '[:cntrl:]')"
  # "// empty" maps JSON null to the empty string, so that a response that does
  # not describe a pull request (as when the request was throttled) falls
  # through to the fallbacks below instead of yielding "null".
  CI_ORGANIZATION=$(printf '%s' "${pull_json}" | jq -r '.head.repo.owner.login // empty' 2> /dev/null)
  if [ -z "$CI_ORGANIZATION" ]; then
    # Warn and fall back, rather than failing:  a throttled request should not
    # fail the whole job.
    emit_echo "${SCRIPT_NAME} warning: bad output for ${url}"
    if [ -n "$auth_token" ]; then
      emit_echo "auth_token is set."
    fi
    emit_echo "---- start of ${http_get_tool} output ----"
    printf '%s\n' "${pull_json}" | emit_echo_lines
    emit_echo "---- end of ${http_get_tool} output ----"
    # GitHub Actions writes the event payload to the file named by
    # $GITHUB_EVENT_PATH, and for a pull request event that payload describes
    # the same pull request that the API request asked about -- including the
    # head repository, which is the fork if the pull request is from one.
    # Prefer it to the fallbacks below, which yield this clone's origin -- the
    # base repository, a wrong answer that a client cloning a companion
    # repository would act on without noticing.
    if [ -r "${GITHUB_EVENT_PATH}" ]; then
      CI_ORGANIZATION=$(jq -r '.pull_request.head.repo.owner.login // empty' "${GITHUB_EVENT_PATH}" 2> /dev/null)
    fi
    if [ -n "$CI_ORGANIZATION" ]; then
      emit_echo "${SCRIPT_NAME}: using organization ${CI_ORGANIZATION} from ${GITHUB_EVENT_PATH}."
    else
      emit_echo "${SCRIPT_NAME}: using the organization of this clone's origin instead,"
      emit_echo "which is the base repository if this is a pull request from a fork."
    fi
  fi
  if [ "$DEBUG" = "--debug" ]; then
    emit_echo "GitHub Actions pull request, GITHUB_HEAD_REF=${GITHUB_HEAD_REF}"
    emit_echo "GITHUB_PR_NUMBER=${GITHUB_PR_NUMBER}"
    emit_echo "CI_ORGANIZATION=${CI_ORGANIZATION}"
  fi
fi

## Git clone
