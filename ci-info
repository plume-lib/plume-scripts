#!/bin/sh

# This script is obsolete.  Use `set-git-range` (preferred) or `git-changes`
# instead.
#
# It used to be a copy of `git-changes`.  Keeping two copies of the same 700
# lines meant that a fix applied to one of them silently left the other one
# broken, so this script is now a shim that runs `git-changes`, for the
# benefit of clients that still name it.  Its arguments, its output, and its
# exit status are those of `git-changes`; see the documentation at the top of
# that file.
#
# One difference from the former copy:  `git-changes` writes the diagnostics
# requested by `--verbose` and `--debug` to standard error, whereas this
# script used to write them to standard output, as commands that print them
# when the client `eval`s this script's output.

exec "$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"/git-changes "$@"
