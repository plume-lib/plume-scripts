#!/bin/sh

# Sets the GitHub organization and branch for a CI job, as shell variables.
# Other information about the CI job can be computed, but it is beyond the
# scope of this simple script.
# Works under Azure Pipelines, CircleCI, GitHub Actions, and Travis CI.
#
# This script is *sourced* by the client, which is why its name starts with
# "set-".

# `local` is not in POSIX, but every shell that can source this file supports
# it, and it is what keeps this script's variables (among them a GitHub
# authorization token) out of the client's shell.
# shellcheck disable=SC3043

# Typical use:
#
#   if [ -d /tmp/plume-scripts ] ; then
#     git -C /tmp/plume-scripts pull -q > /dev/null 2>&1
#   else
#     mkdir -p /tmp && git -C /tmp clone --depth=1 -q https://github.com/plume-lib/plume-scripts.git
#   fi
#   CI_DEFAULT_ORGANIZATION=MY-DEFAULT-ORGANIZATION
#   . /tmp/plume-scripts/set-ci-org-and-branch
#
# Alternatively, to use a specific version of this script rather than the latest:
#
#   if [ ! -d /tmp/$USER/plume-scripts ] ; then
#     mkdir -p /tmp/$USER
#     git -C /tmp/$USER clone --revision=e768754ffafad4a9f1e26c5305591d4061d890b4 --depth=1 -q https://github.com/plume-lib/plume-scripts.git
#   fi
#   CI_DEFAULT_ORGANIZATION=MY-DEFAULT-ORGANIZATION
#   . /tmp/$USER/plume-scripts/set-ci-org-and-branch

# Either snippet of code sets these variables:
# CI_ORGANIZATION: The GitHub organization.  In a PR, refers to the source or head.
#   Variable CI_DEFAULT_ORGANIZATION is used if no organization can be determined.
# CI_BRANCH: The name of the source/head branch (in a PR) or of the branch being tested.
# CI_DEFAULT_BRANCH_NAME: The default branch of the "origin" remote, such as
#   "master" or "main".  Computing it requires contacting the remote, so this
#   script provides it rather than making each client compute it again.
# CI_PULL_JSON: The GitHub API's description of the pull request, if this script
#   requested one; otherwise empty.  A client that needs more information about
#   the pull request should read this rather than repeat the request, which
#   might be throttled.  Unlike the other three variables, it is not exported,
#   because it is large and no subprocess needs it.
#
# The script sets no other variables and leaves no functions defined.  It
# returns 0 on success, or 2 if it cannot determine the information; in the
# latter case all four variables are set to the empty string.

# The client configures this script by setting variables rather than by passing
# command-line arguments.
# CI_DEFAULT_ORGANIZATION: use this organization if none can be determined.  Optional.
# CI_VERBOSE: if non-empty, report progress.  Optional.
# CI_DEBUG: if non-empty, report voluminous debugging information.  Implies
#   CI_VERBOSE.  Optional.
# If environment variable GITHUB_PAT or GH_TOKEN is set when this script is
# called, it is used as GitHub Personal Access Token when making GitHub API
# calls.  This can avoid "403 rate limit exceeded" failures.
#
# All reporting is to standard error, so that sourcing this script cannot
# corrupt output that the client is producing.

# Requires the `jq` program and either `curl` or `wget`.

# Alternatives:  The gradle-git-properties plugin automatically detects branch
# names from various CI environments.

# When this file is sourced, "$0" is the client's name rather than this file's
# name; so if "$0" is this file's name, the client ran it instead of sourcing it.
case $0 in
  */set-ci-org-and-branch | set-ci-org-and-branch)
    echo "set-ci-org-and-branch must be sourced (\`. set-ci-org-and-branch\`), not run." >&2
    echo "To run a script instead, use \`eval \"\$(ci-org-and-branch)\"\`." >&2
    exit 2
    ;;
esac

### Functions

# _ci_get_url URL: fetch URL to standard output, sending an Authorization header
# if $auth_token is set.  The header is passed as a single argument rather than
# being word-split out of a command string; that avoids mangling the header and
# leaking the token into stray connection attempts.
_ci_get_url() {
  if [ "$http_get_tool" = "curl" ]; then
    if [ -n "$auth_token" ]; then
      curl -s --header "Authorization: token $auth_token" "$1"
    else
      curl -s "$1"
    fi
  else
    if [ -n "$auth_token" ]; then
      wget -q -O - --header="Authorization: token $auth_token" "$1"
    else
      wget -q -O - "$1"
    fi
  fi
}

# Does all the work.  Its caller protects the client from its shell options.
_ci_set_org_and_branch_body() {
  local SCRIPT_NAME="set-ci-org-and-branch"
  local verbose="$CI_VERBOSE"
  local debug="$CI_DEBUG"
  local auth_token
  local http_get_tool
  local url
  local SLUG
  local URL
  local GITHUB_PR_NUMBER

  if [ -n "$debug" ]; then
    verbose="$debug"
  fi

  # Compute the values from scratch, rather than reusing values that the client
  # or a previous sourcing of this script left in the environment.
  CI_ORGANIZATION=""
  CI_BRANCH=""
  CI_DEFAULT_BRANCH_NAME=""
  CI_PULL_JSON=""

  if [ -n "$debug" ]; then
    {
      echo "${SCRIPT_NAME} is running in $(pwd)"
      echo
      # `env` only prints EXPORTED variables, so `set` is usually more useful.
      echo '---------------- start of env'
      env -0 | sort -z | tr '\0' '\n'
      echo '---------------- end of env'
      echo
      echo '---------------- start of set'
      set
      echo '---------------- end of set'
      echo
      echo '---------------- start of git status'
      git --no-pager status
      echo '---------------- end of git status'
      echo
      echo '---------------- start of all branches'
      git --no-pager branch -a
      echo '---------------- end of all branches'
      echo
      echo '---------------- start of all remote branches'
      git --no-pager branch -r
      echo '---------------- end of all branches'
      echo
      echo '---------------- start of 1000 lines of git log'
      git --no-pager log --graph | head --lines=1000
      echo '---------------- end of 1000 lines of git log'
      echo
    } >&2
  fi

  ### Variables

  # "GITHUB_PAT" is a GitHub Personal Access Token.
  # TODO: Should this be "Authorization: Bearer <YOUR-TOKEN>" instead?  See https://docs.github.com/en/rest/pulls/pulls#get-a-pull-request
  if [ -n "$GITHUB_PAT" ]; then
    auth_token="$GITHUB_PAT"
  elif [ -n "$GH_TOKEN" ]; then
    auth_token="$GH_TOKEN"
  else
    auth_token=""
  fi

  ### Prerequisites

  # TODO: Try to not access the GitHub REST API, because it can get throttled.
  if [ -n "$(command -v curl 2> /dev/null)" ]; then
    http_get_tool="curl"
  elif [ -n "$(command -v wget 2> /dev/null)" ]; then
    http_get_tool="wget"
  else
    echo "${SCRIPT_NAME}: neither curl nor wget is installed" >&2
    return 2
  fi

  if [ -z "$(command -v jq 2> /dev/null)" ]; then
    echo "${SCRIPT_NAME}: jq is not installed" >&2
    return 2
  fi

  ### Organization

  ## Continuous integration services
  if [ "$TRAVIS" = "true" ]; then
    CI_ORGANIZATION=${TRAVIS_PULL_REQUEST_SLUG%/*}
    if [ -z "$CI_ORGANIZATION" ]; then
      CI_ORGANIZATION=${TRAVIS_REPO_SLUG%/*}
    fi
  elif [ -n "$AZURE_HTTP_USER_AGENT" ]; then
    # TODO: Can I implement this without a GitHub API request?
    if [ "$BUILD_REASON" = "PullRequest" ]; then
      url="https://api.github.com/repos/${BUILD_REPOSITORY_NAME}/pulls/${SYSTEM_PULLREQUEST_PULLREQUESTNUMBER}"
      CI_PULL_JSON="$(_ci_get_url "${url}" 2>&1 | tr -d '[:cntrl:]')"
      # "// empty" maps JSON null to the empty string, so that the test below
      # detects a response that does not describe a pull request; without it,
      # jq yields the string "null" and the test passes.
      SLUG=$(printf '%s' "${CI_PULL_JSON}" | jq -r '.head.label // empty' 2> /dev/null)
      if [ -z "$SLUG" ]; then
        {
          echo "${SCRIPT_NAME} error: bad output for ${url}"
          if [ -n "$auth_token" ]; then
            echo "auth_token is set."
          fi
          echo "---- start of ${http_get_tool} output ----"
          printf '%s\n' "${CI_PULL_JSON}"
          echo "---- end of ${http_get_tool} output ----"
        } >&2
        return 2
      fi
      CI_ORGANIZATION=${SLUG%:*}
    else
      CI_ORGANIZATION=${BUILD_REPOSITORY_NAME%/*}
      # CI_REPO=${BUILD_REPOSITORY_NAME##*/}
    fi
  elif [ -n "$CIRCLE_PR_USERNAME" ]; then
    CI_ORGANIZATION="$CIRCLE_PR_USERNAME"
  elif [ -n "$GITHUB_HEAD_REF" ]; then
    # GitHub Actions pull request

    # TODO: Can I implement this without a GitHub API request?
    # Is GITHUB_ACTOR equal to CI_ORGANIZATION, maybe??  (Need to observe beyond mernst.)
    GITHUB_PR_NUMBER=${GITHUB_REF_NAME%/merge}
    url="https://api.github.com/repos/${GITHUB_REPOSITORY}/pulls/${GITHUB_PR_NUMBER}"
    CI_PULL_JSON="$(_ci_get_url "${url}" 2>&1 | tr -d '[:cntrl:]')"
    # "// empty" maps JSON null to the empty string, so that a response that
    # does not describe a pull request (as when the request was throttled)
    # falls through to the fallbacks below instead of yielding "null".
    CI_ORGANIZATION=$(printf '%s' "${CI_PULL_JSON}" | jq -r '.head.repo.owner.login // empty' 2> /dev/null)
    if [ -n "$debug" ]; then
      {
        echo "GitHub Actions pull request, GITHUB_HEAD_REF=${GITHUB_HEAD_REF}"
        echo "GITHUB_PR_NUMBER=${GITHUB_PR_NUMBER}"
        echo "CI_ORGANIZATION=${CI_ORGANIZATION}"
      } >&2
    fi
  fi

  ## Git clone
  if [ -z "$CI_ORGANIZATION" ]; then
    URL=$(git config --get remote.origin.url)
    # This removes the leading part of two possible forms for a URL:
    #   https://github.com/mernst/annotation-tools
    #   git@github.com:mernst/annotation-tools.git
    SLUG=${URL#https://github.com/}
    SLUG=${SLUG#git@github.com:}
    CI_ORGANIZATION=${SLUG%/*}
    # TODO: Maybe add a sanity check here.
  fi

  ## Default
  if [ -z "$CI_ORGANIZATION" ]; then
    CI_ORGANIZATION="${CI_DEFAULT_ORGANIZATION}"
  fi

  if [ -n "$debug" ]; then
    echo "CI_ORGANIZATION=${CI_ORGANIZATION}" >&2
  fi

  ### Other information (besides organization)

  ## Both of these commands for CI_DEFAULT_BRANCH_NAME seem to work.
  # CI_DEFAULT_BRANCH_NAME=$(git ls-remote --symref "$(git config --get remote.origin.url)" HEAD | awk '/^ref:/ {sub(/refs\/heads\//, "", $2); print $2}')
  CI_DEFAULT_BRANCH_NAME=$(git remote show origin | grep 'HEAD branch' | cut -d' ' -f5)
  if [ -n "$debug" ]; then
    {
      echo "remote's CI_DEFAULT_BRANCH_NAME=$CI_DEFAULT_BRANCH_NAME"
      if [ -n "${URL}" ]; then
        echo "HEAD of ${URL} = $(git ls-remote --symref "${URL}" HEAD)" 2>&1
      else
        echo "URL is empty (is set only for non-CI runs)"
      fi
      echo "current branch: $(git branch --show-current)"
      echo "current repo: $(git config --get remote.origin.url)"
    } >&2
  fi

  if [ -n "$SYSTEM_PULLREQUEST_TARGETBRANCH" ]; then
    ## Azure Pipelines pull request
    if [ -n "$debug" ]; then
      echo "Azure Pipelines pull request $SYSTEM_PULLREQUEST_TARGETBRANCH" >&2
    fi
    # WARNING!  $BUILD_SOURCEBRANCHNAME is just a name, not a full ref path.  For example,
    # $BUILD_SOURCEBRANCHNAME may be "merge" when $BUILD_SOURCEBRANCH is "refs/pull/2971/merge".
    CI_BRANCH=$SYSTEM_PULLREQUEST_SOURCEBRANCH
  elif [ -n "$BUILD_SOURCEBRANCH" ]; then
    # Azure Pipelines build for a branch (possibly master).
    if [ -n "$debug" ]; then
      {
        echo "Azure Pipelines build for a branch $BUILD_SOURCEBRANCH"
        echo "SYSTEM_PULLREQUEST_TARGETBRANCH=$SYSTEM_PULLREQUEST_TARGETBRANCH is not set but BUILD_SOURCEBRANCH=$BUILD_SOURCEBRANCH"
      } >&2
    fi
    # In Azure Pipelines:  BUILD_SOURCEBRANCH is a full ref path like "refs/heads/mybranch";
    # BUILD_SOURCEBRANCHNAME is a short name like "mybranch"; $BUILD_SOURCEVERSION is a commit ID.
    # Some clients such as `git-clone-related` MUST be given a branch name, not a commit ID.
    CI_BRANCH=$BUILD_SOURCEBRANCHNAME
  elif [ "$TRAVIS" = "true" ]; then
    ## Travis CI
    if [ -n "$debug" ]; then
      echo "Travis CI $TRAVIS" >&2
    fi
    CI_BRANCH=${TRAVIS_PULL_REQUEST_BRANCH:-$TRAVIS_BRANCH}
    if [ -n "$verbose" ]; then
      {
        echo "TRAVIS_PULL_REQUEST_BRANCH=$TRAVIS_PULL_REQUEST_BRANCH"
        echo "TRAVIS_BRANCH=$TRAVIS_BRANCH"
        echo "CI_BRANCH=$CI_BRANCH"
      } >&2
    fi

  elif [ -n "$CIRCLECI" ]; then
    if [ -n "$CIRCLE_PR_NUMBER" ]; then
      # TODO: Can I implement this without a GitHub API request?
      # The request is unauthenticated, so it is subject to throttling.
      # "// empty" maps JSON null to the empty string; the redirection discards
      # jq's complaint if the response is not JSON at all (as when throttling
      # yields an HTML error page).
      url="https://api.github.com/repos/${CIRCLE_PROJECT_USERNAME}/${CIRCLE_PROJECT_REPONAME}/pulls/${CIRCLE_PR_NUMBER}"
      CI_PULL_JSON="$(_ci_get_url "${url}" | tr -d '[:cntrl:]')"
      CI_BRANCH=$(printf '%s' "${CI_PULL_JSON}" | jq -r '.head.ref // empty' 2> /dev/null)
      if [ -z "$CI_BRANCH" ]; then
        # For a pull request, this is like "pull/1234" rather than a branch name.
        CI_BRANCH=$CIRCLE_BRANCH
      fi
    else
      CI_BRANCH=$CIRCLE_BRANCH
    fi

  elif [ -n "${GITHUB_HEAD_REF}" ]; then
    # GitHub Actions pull request (no special handling is required for non-PR GitHub Actions jobs).
    if [ -n "$debug" ]; then
      {
        echo "GitHub Actions pull request https://github.com/${GITHUB_REPOSITORY}/pull/${GITHUB_PR_NUMBER}"
        echo "  GITHUB_BASE_REF=${GITHUB_BASE_REF}"
        echo "  GITHUB_REF_NAME=${GITHUB_REF_NAME}"
        echo "  GITHUB_SHA=${GITHUB_SHA}"
        # GITHUB_HEAD_REF is in the PR fork which is not available.
        echo "  GITHUB_HEAD_REF=${GITHUB_HEAD_REF}"
      } >&2
    fi
    # At this point, these two are the same:
    # git rev-parse HEAD
    # git rev-parse remotes/pull/"${GITHUB_REF_NAME}"

    GITHUB_PR_NUMBER=${GITHUB_REF_NAME%/merge}

    CI_BRANCH="${GITHUB_HEAD_REF}"

    # If this elif is reached, it's not a pull request (except maybe a re-run Azure Pipelines pull request).
  elif [ -n "$GITHUB_ACTIONS" ]; then
    # GitHub Actions, non-pull-request.
    if [ -n "$debug" ]; then
      echo "GitHub Actions, not a pull request, GITHUB_REF_NAME=${GITHUB_REF_NAME}, GITHUB_SHA=${GITHUB_SHA}, head=$(git rev-parse HEAD)" >&2
    fi

    if [ "${GITHUB_EVENT_NAME}" = "pull_request" ]; then
      echo "${SCRIPT_NAME}: GITHUB_EVENT_NAME=${GITHUB_EVENT_NAME}" >&2
      return 2
    fi

    # GITHUB_REF_NAME may be a branch name or "40/merge".
    if [ -n "$(git branch --list "${GITHUB_REF_NAME}")" ]; then
      CI_BRANCH="${GITHUB_REF_NAME}"
    else
      # TODO: Can I implement this without a GitHub API request?
      # GITHUB_REF_NAME is like "40/merge" here, so strip "/merge" for the PR number.
      url="https://api.github.com/repos/${GITHUB_REPOSITORY}/pulls/${GITHUB_REF_NAME%/merge}"
      CI_PULL_JSON="$(_ci_get_url "${url}" | tr -d '[:cntrl:]')"
      CI_BRANCH=$(printf '%s' "${CI_PULL_JSON}" | jq -r '.head.ref // empty' 2> /dev/null)
    fi

  else

    if [ -n "$debug" ]; then
      echo "Else clause: no CI environment detected" >&2
    fi
    # git 2.22 and later has `git branch --show-current`; CircleCI doesn't have that version yet.
    CI_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    # In an Azure Pipelines pull request, `git branch` yields "(HEAD detached at pull/4/merge)".
    # If you re-run a pull request via "Queue" rather than "Rebuild",
    # variables SYSTEM_PULLREQUEST_TARGETBRANCH and SYSTEM_PULLREQUEST_SOURCEBRANCH are not set.
    if [ "$CI_BRANCH" = '(HEAD' ]; then
      CI_BRANCH=$CI_DEFAULT_BRANCH_NAME
    fi
  fi

  if [ -n "$debug" ]; then
    echo "CI_BRANCH=${CI_BRANCH}" >&2
  fi

  if [ -n "$verbose" ]; then
    # A throttled or otherwise failed request also has a non-empty response body,
    # so test whether the response really does describe a pull request.
    if [ -n "${CI_PULL_JSON}" ] \
      && printf '%s' "${CI_PULL_JSON}" | jq -e -r '.head.sha // empty' > /dev/null 2>&1; then
      echo "CI_ACCESSED_GITHUB_API=true" >&2
    else
      echo "CI_ACCESSED_GITHUB_API=false" >&2
    fi
  fi

  ### Set it

  export CI_ORGANIZATION
  export CI_BRANCH
  export CI_DEFAULT_BRANCH_NAME
  if [ -n "$verbose" ]; then
    {
      echo "CI_ORGANIZATION=$CI_ORGANIZATION"
      echo "CI_BRANCH=$CI_BRANCH"
    } >&2
  fi
}

# Give the body shell options that suit it, then restore the client's options.
# The client's `set -u` would abort on the many CI variables that are unset
# outside their own CI service, and its `set -e` would abort on a command whose
# failure this script handles itself.
# Only the two options that this script changes are saved, and they are read
# from "$-" rather than from `set +o`:  bash and BusyBox ash turn errexit off
# inside the command substitution that capturing `set +o` requires, so a
# captured `set +o` would report errexit as off and turn it off in the client.
case $- in
  *e*) _ci_had_errexit="true" ;;
  *) _ci_had_errexit="" ;;
esac
case $- in
  *u*) _ci_had_nounset="true" ;;
  *) _ci_had_nounset="" ;;
esac
set +e +u

_ci_set_org_and_branch_body
_ci_status=$?

# Clean up before restoring `set -e`, which makes the shell exit here if the
# client uses `set -e` and this script failed.
unset -f _ci_set_org_and_branch_body _ci_get_url
if [ -n "$_ci_had_errexit" ]; then
  set -e
fi
if [ -n "$_ci_had_nounset" ]; then
  set -u
fi
unset _ci_had_errexit _ci_had_nounset
# Unset the last of this script's variables and return, in a single command
# because unsetting the variable would otherwise lose the status.
eval "unset _ci_status; return ${_ci_status}"
