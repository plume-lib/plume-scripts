#!/bin/sh

# Sets the GitHub organization and branch for a CI job, as shell variables.
# Works under Azure Pipelines, CircleCI, GitHub Actions, and Travis CI.
#
# This script is *sourced* by the client, which is why its name starts with
# "set-".

# `local` is not in POSIX, but every shell that can source this file supports it.
# shellcheck disable=SC3043

# Typical use:
#
#   if [ -d /tmp/plume-scripts ] ; then
#     git -C /tmp/plume-scripts pull -q > /dev/null 2>&1
#   else
#     mkdir -p /tmp && git -C /tmp clone --depth=1 -q https://github.com/plume-lib/plume-scripts.git
#   fi
#   CI_DEFAULT_ORGANIZATION=MY-DEFAULT-ORGANIZATION
#   . /tmp/plume-scripts/set-ci-org-and-branch
#
# Alternatively, to use a specific version of this script rather than the latest:
#
#   if [ ! -d /tmp/$USER/plume-scripts ] ; then
#     mkdir -p /tmp/$USER
#     git -C /tmp/$USER clone --revision=e768754ffafad4a9f1e26c5305591d4061d890b4 --depth=1 -q https://github.com/plume-lib/plume-scripts.git
#   fi
#   CI_DEFAULT_ORGANIZATION=MY-DEFAULT-ORGANIZATION
#   . /tmp/$USER/plume-scripts/set-ci-org-and-branch

# Either snippet of code sets these variables:
# CI_ORGANIZATION: The GitHub organization.  In a PR, refers to the source or head.
#   Variable CI_DEFAULT_ORGANIZATION is used if no organization can be determined.
# CI_BRANCH: The name of the source/head branch (in a PR) or of the branch being tested.
# CI_DEFAULT_BRANCH_NAME: The default branch of the "origin" remote, such as
#   "master" or "main".  Provided so that clients don't have to compute it again.
# CI_PULL_JSON: The GitHub API's description of the pull request, if this script
#   requested one; otherwise empty.  Provided so that clients don't have to make
#   another network request, which might get throttled.  Unlike the other three
#   variables, it is not exported, because it is large and no subprocess needs
#   it.
#
# The script sets no other variables and leaves no functions defined.  It
# returns 0 on success, or 2 if it cannot determine the information; in the
# latter case all four variables are set to the empty string.

# The client configures this script by setting optional variables rather than
# by passing command-line arguments.
# CI_DEFAULT_ORGANIZATION: use this organization if the script cannot determine one.
# CI_VERBOSE: if non-empty, report progress.
# CI_DEBUG: if non-empty, report voluminous debugging information.
# If environment variable GITHUB_PAT or GH_TOKEN is set when this script is
# called, it is used as GitHub Personal Access Token when making GitHub API
# calls.  This can avoid "403 rate limit exceeded" failures.

# Requires the `jq` program and either `curl` or `wget`.

# Alternatives:  The gradle-git-properties plugin automatically detects branch
# names from various CI environments.

# When this file is sourced, "$0" is the client's name rather than this file's
# name; so if "$0" is this file's name, the client ran it instead of sourcing it.
case $0 in
  */set-ci-org-and-branch | set-ci-org-and-branch)
    echo "set-ci-org-and-branch must be sourced (\`. set-ci-org-and-branch\`), not run." >&2
    exit 2
    ;;
esac

### Functions

# _scoab_get_url URL: fetch URL to standard output, sending an Authorization header
# if $auth_token is set.  The header is passed as a single argument rather than
# being word-split out of a command string; that avoids mangling the header and
# leaking the token into stray connection attempts.
# The timeouts bound how long a CI job waits when the network or the GitHub API
# is unresponsive; without them, one request can hang until the job's own limit.
# For `wget`, the short options are used because BusyBox wget accepts only those.
_scoab_get_url() {
  if [ "$http_get_tool" = "curl" ]; then
    if [ -n "$auth_token" ]; then
      curl -s --connect-timeout 10 --max-time 30 --header "Authorization: token $auth_token" "$1"
    else
      curl -s --connect-timeout 10 --max-time 30 "$1"
    fi
  else
    if [ -n "$auth_token" ]; then
      wget -q -O - -T 30 -t 2 --header="Authorization: token $auth_token" "$1"
    else
      wget -q -O - -T 30 -t 2 "$1"
    fi
  fi
}

# Copies standard input to standard output, with the value of each variable
# whose name suggests a credential replaced.  The debug dump would otherwise
# write secrets into the CI log, which is often readable by anyone who can see
# the job.  Matching by name pattern rather than by an allowlist of names also
# covers secrets that this script does not know about; GitHub Actions, for
# example, defines $ACTIONS_RUNTIME_TOKEN in every job and does not mask it.
# `set` prints a function's local variables too, which is why $auth_token is
# assigned before the debug dump runs:  the pattern masks it there as well.
_scoab_redact_tokens() {
  awk '
    /^[A-Za-z_][A-Za-z0-9_]*=/ {
      name = $0
      sub(/=.*/, "", name)
      if (toupper(name) ~ /TOKEN|SECRET|PASSWORD|PASSWD|PASSPHRASE|CREDENTIAL|APIKEY|API_KEY|PRIVATE_KEY|_PAT$|^PAT$/) {
        print name "=<redacted>"
        next
      }
    }
    { print }
  '
}

# _scoab_org_from_url URL: prints the GitHub organization of a repository URL,
# or nothing if the argument is not a GitHub repository URL.  The caller treats
# no output as "unknown" and falls back to $CI_DEFAULT_ORGANIZATION, so it is
# better to print nothing than to print a guess.
# These are the forms that git accepts and that can name GitHub:
#   https://github.com/mernst/annotation-tools[.git]
#   https://USER[:TOKEN]@github.com/mernst/annotation-tools[.git]
#   http://github.com/mernst/annotation-tools[.git]
#   git://github.com/mernst/annotation-tools[.git]
#   ssh://git@github.com[:PORT]/mernst/annotation-tools[.git]
#   git@github.com:mernst/annotation-tools[.git]   (git's scp-like syntax)
# A local path such as "../plume-scripts" is not one of them; neither is a URL
# for some other forge.  Printing the leading component of those would yield an
# organization that does not exist -- and, for a URL that embeds a credential,
# would copy the credential into $CI_ORGANIZATION and thence into the log.
_scoab_org_from_url() {
  local rest="$1"
  local host
  local path

  case $rest in
    ssh://* | git://* | http://* | https://*)
      rest=${rest#*://}
      # The host is everything before the first "/", which must be present:
      # these forms have no path-less spelling.
      case $rest in
        */*)
          host=${rest%%/*}
          path=${rest#*/}
          ;;
        *) return 0 ;;
      esac
      ;;
    *://*)
      # Some other scheme, such as git's file://.
      return 0
      ;;
    *:*)
      # The scp-like syntax, [USER@]HOST:PATH.  It has no "//", so the case
      # above has already ruled out every URL with a scheme.  A Windows path
      # such as "C:/repo" also matches, but git treats that as scp-like syntax
      # too, so this function is no more wrong about it than git is.
      host=${rest%%:*}
      path=${rest#*:}
      ;;
    *)
      # A local path, or a bare name.
      return 0
      ;;
  esac

  # Discard any userinfo ("git@", "USER:TOKEN@") and any port.
  host=${host##*@}
  host=${host%%:*}
  case $host in
    github.com | www.github.com) : ;;
    *) return 0 ;;
  esac

  # The organization is the first component of the path.  Requiring a second
  # component rejects a URL that names no repository.
  path=${path#/}
  case $path in
    */*) printf '%s\n' "${path%%/*}" ;;
  esac
}

# Does all the work.  Its caller gives it the shell options it needs, and
# restores the client's options afterward.
_scoab_set_org_and_branch_body() {
  local SCRIPT_NAME="set-ci-org-and-branch"
  local verbose="$CI_VERBOSE"
  local debug="$CI_DEBUG"
  local auth_token
  local http_get_tool
  local api_url
  local SLUG
  local origin_url
  local GITHUB_PR_NUMBER
  local local_head_ref

  if [ -n "$debug" ]; then
    verbose="$debug"
  fi

  # Compute the values from scratch, rather than reusing values that the client
  # or a previous sourcing of this script left in the environment.
  CI_ORGANIZATION=""
  CI_BRANCH=""
  CI_DEFAULT_BRANCH_NAME=""
  CI_PULL_JSON=""

  ### Variables

  # "GITHUB_PAT" is a GitHub Personal Access Token.
  # TODO: Should this be "Authorization: Bearer <YOUR-TOKEN>" instead?  See https://docs.github.com/en/rest/pulls/pulls#get-a-pull-request
  # Assign this before the debug dump below, so that `set`'s copy of it is
  # redacted there rather than being absent and looking safe.
  if [ -n "$GITHUB_PAT" ]; then
    auth_token="$GITHUB_PAT"
  elif [ -n "$GH_TOKEN" ]; then
    auth_token="$GH_TOKEN"
  else
    auth_token=""
  fi

  if [ -n "$debug" ]; then
    {
      # All this output is to stderr.
      echo "${SCRIPT_NAME} is running in $(pwd)"
      echo
      # `env` only prints EXPORTED variables, so `set` is usually more useful.
      echo '---------------- start of env'
      # Print the environment with awk's ENVIRON array rather than with
      # `env -0 | sort -z`:  the `-0` and `-z` options are GNU extensions that
      # BusyBox and BSD lack, so on those platforms this dump would be empty.
      # (Under GNU awk, ENVIRON also contains awk's own AWKPATH and AWKLIBPATH,
      # whether or not the environment defines them.)
      # Each variable becomes exactly one line, with newlines in its value
      # shown as "\n"; a multi-line value would otherwise scramble the sort and
      # slip its continuation lines past the redaction below.  The escaping is
      # done by concatenation because a backslash in `gsub`'s replacement text
      # is not portable:  BusyBox awk and GNU awk interpret it differently.
      awk '
        BEGIN {
          for (name in ENVIRON) {
            parts = split(ENVIRON[name], part, /\n/)
            value = part[1]
            for (i = 2; i <= parts; i++) {
              value = value "\\n" part[i]
            }
            print name "=" value
          }
        }
      ' | sort | _scoab_redact_tokens
      echo '---------------- end of env'
      echo
      echo '---------------- start of set'
      set | _scoab_redact_tokens
      echo '---------------- end of set'
      echo
      echo '---------------- start of git status'
      git --no-pager status
      echo '---------------- end of git status'
      echo
      echo '---------------- start of all branches'
      git --no-pager branch -a
      echo '---------------- end of all branches'
      echo
      echo '---------------- start of all remote branches'
      git --no-pager branch -r
      echo '---------------- end of all branches'
      echo
      echo '---------------- start of 1000 lines of git log'
      git --no-pager log --graph | head -n 1000
      echo '---------------- end of 1000 lines of git log'
      echo
    } >&2
  fi

  ### Prerequisites

  # TODO: Try to not access the GitHub REST API, because it can get throttled.
  if [ -n "$(command -v curl 2> /dev/null)" ]; then
    http_get_tool="curl"
  elif [ -n "$(command -v wget 2> /dev/null)" ]; then
    http_get_tool="wget"
  else
    echo "${SCRIPT_NAME}: neither curl nor wget is installed" >&2
    return 2
  fi

  if [ -z "$(command -v jq 2> /dev/null)" ]; then
    echo "${SCRIPT_NAME}: jq is not installed" >&2
    return 2
  fi

  ### Organization

  ## Continuous integration services
  if [ "$TRAVIS" = "true" ]; then
    CI_ORGANIZATION=${TRAVIS_PULL_REQUEST_SLUG%/*}
    if [ -z "$CI_ORGANIZATION" ]; then
      CI_ORGANIZATION=${TRAVIS_REPO_SLUG%/*}
    fi
  elif [ -n "$AZURE_HTTP_USER_AGENT" ]; then
    # TODO: Can I implement this without a GitHub API request?
    if [ "$BUILD_REASON" = "PullRequest" ]; then
      api_url="https://api.github.com/repos/${BUILD_REPOSITORY_NAME}/pulls/${SYSTEM_PULLREQUEST_PULLREQUESTNUMBER}"
      CI_PULL_JSON="$(_scoab_get_url "${api_url}" | tr -d '[:cntrl:]')"
      # "// empty" maps JSON null to the empty string, so jq does not yield the string "null".
      SLUG=$(printf '%s' "${CI_PULL_JSON}" | jq -r '.head.label // empty' 2> /dev/null)
      if [ -n "$SLUG" ]; then
        CI_ORGANIZATION=${SLUG%:*}
      else
        # Warn and fall back, rather than failing:  a throttled request should
        # not fail the whole job.
        {
          echo "${SCRIPT_NAME} warning: bad output for ${api_url}"
          if [ -n "$auth_token" ]; then
            echo "auth_token is set."
          fi
          echo "---- start of ${http_get_tool} output ----"
          printf '%s\n' "${CI_PULL_JSON}"
          echo "---- end of ${http_get_tool} output ----"
        } >&2
        # Azure sets $SYSTEM_PULLREQUEST_SOURCEREPOSITORYURI to the pull
        # request's head repository, which is the fork if the pull request is
        # from one.  Prefer it to the fallbacks below, which yield this clone's
        # origin -- the base repository, a wrong answer that a client cloning a
        # companion repository would act on without noticing.
        if [ -n "$SYSTEM_PULLREQUEST_SOURCEREPOSITORYURI" ]; then
          CI_ORGANIZATION=$(_scoab_org_from_url "$SYSTEM_PULLREQUEST_SOURCEREPOSITORYURI")
        fi
        if [ -n "$CI_ORGANIZATION" ]; then
          echo "${SCRIPT_NAME}: using organization ${CI_ORGANIZATION} from SYSTEM_PULLREQUEST_SOURCEREPOSITORYURI=${SYSTEM_PULLREQUEST_SOURCEREPOSITORYURI}." >&2
        else
          {
            echo "${SCRIPT_NAME}: using the organization of this clone's origin instead,"
            echo "which is the base repository if this is a pull request from a fork."
          } >&2
        fi
      fi
    else
      CI_ORGANIZATION=${BUILD_REPOSITORY_NAME%/*}
      # CI_REPO=${BUILD_REPOSITORY_NAME##*/}
    fi
  elif [ -n "$CIRCLE_PR_USERNAME" ]; then
    CI_ORGANIZATION="$CIRCLE_PR_USERNAME"
  elif [ -n "$GITHUB_HEAD_REF" ]; then
    # GitHub Actions pull request

    # TODO: Can I implement this without a GitHub API request?
    # Is GITHUB_ACTOR equal to CI_ORGANIZATION, maybe??  (Need to observe beyond mernst.)
    GITHUB_PR_NUMBER=${GITHUB_REF_NAME%/merge}
    api_url="https://api.github.com/repos/${GITHUB_REPOSITORY}/pulls/${GITHUB_PR_NUMBER}"
    CI_PULL_JSON="$(_scoab_get_url "${api_url}" | tr -d '[:cntrl:]')"
    # "// empty" maps JSON null to the empty string, so jq does not yield the string "null".
    CI_ORGANIZATION=$(printf '%s' "${CI_PULL_JSON}" | jq -r '.head.repo.owner.login // empty' 2> /dev/null)
    if [ -n "$debug" ]; then
      {
        echo "GitHub Actions pull request, GITHUB_HEAD_REF=${GITHUB_HEAD_REF}"
        echo "GITHUB_PR_NUMBER=${GITHUB_PR_NUMBER}"
        echo "CI_ORGANIZATION=${CI_ORGANIZATION}"
      } >&2
    fi
  fi

  ## Git clone
  if [ -z "$CI_ORGANIZATION" ]; then
    origin_url=$(git config --get remote.origin.url)
    CI_ORGANIZATION=$(_scoab_org_from_url "$origin_url")
    # TODO: Maybe add a sanity check here.
  fi

  ## Default
  if [ -z "$CI_ORGANIZATION" ]; then
    CI_ORGANIZATION="${CI_DEFAULT_ORGANIZATION}"
  fi

  if [ -n "$debug" ]; then
    echo "CI_ORGANIZATION=${CI_ORGANIZATION}" >&2
  fi

  ### Other information (besides organization)

  ## `git remote show origin | grep 'HEAD branch' | cut -d' ' -f5` also works,
  ## but only in an English locale:  `git remote show` is porcelain, so git
  ## translates its output.  `git ls-remote` is plumbing, so its output is stable.
  CI_DEFAULT_BRANCH_NAME=$(git ls-remote --symref origin HEAD | awk '/^ref:/ {sub(/refs\/heads\//, "", $2); print $2}')
  if [ -z "$CI_DEFAULT_BRANCH_NAME" ]; then
    # `git ls-remote` failed, or origin's HEAD is not a symbolic ref.  The
    # network may be down, or origin may require credentials that this checkout
    # does not have (a GitHub Actions job that uses `persist-credentials: false`
    # has none, for example).  Fall back to the remote-tracking HEAD that
    # `git clone` recorded locally.  Warn either way:  a client that silently
    # gets an empty default branch name computes something other than what it
    # asked for, and the resulting diagnostics blame the wrong thing.
    local_head_ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2> /dev/null)
    CI_DEFAULT_BRANCH_NAME=${local_head_ref#origin/}
    if [ -n "$CI_DEFAULT_BRANCH_NAME" ]; then
      echo "${SCRIPT_NAME}: cannot ask origin for its default branch; using ${CI_DEFAULT_BRANCH_NAME} from refs/remotes/origin/HEAD instead." >&2
    else
      echo "${SCRIPT_NAME}: WARNING: cannot determine the default branch name, from origin or from refs/remotes/origin/HEAD." >&2
    fi
  fi
  if [ -n "$debug" ]; then
    {
      echo "remote's CI_DEFAULT_BRANCH_NAME=$CI_DEFAULT_BRANCH_NAME"
      if [ -n "${origin_url}" ]; then
        echo "HEAD of ${origin_url} = $(git ls-remote --symref "${origin_url}" HEAD)" 2>&1
      else
        echo "origin_url is empty (is set only for non-CI runs)"
      fi
      echo "current branch: $(git branch --show-current)"
      echo "current repo: $(git config --get remote.origin.url)"
    } >&2
  fi

  if [ -n "$SYSTEM_PULLREQUEST_TARGETBRANCH" ]; then
    ## Azure Pipelines pull request
    if [ -n "$debug" ]; then
      echo "Azure Pipelines pull request $SYSTEM_PULLREQUEST_TARGETBRANCH" >&2
    fi
    # WARNING!  $BUILD_SOURCEBRANCHNAME is just a name, not a full ref path.  For example,
    # $BUILD_SOURCEBRANCHNAME may be "merge" when $BUILD_SOURCEBRANCH is "refs/pull/2971/merge".
    CI_BRANCH=$SYSTEM_PULLREQUEST_SOURCEBRANCH
  elif [ -n "$BUILD_SOURCEBRANCH" ]; then
    # Azure Pipelines build for a branch (possibly master).
    if [ -n "$debug" ]; then
      {
        echo "Azure Pipelines build for a branch $BUILD_SOURCEBRANCH"
        echo "SYSTEM_PULLREQUEST_TARGETBRANCH=$SYSTEM_PULLREQUEST_TARGETBRANCH is not set but BUILD_SOURCEBRANCH=$BUILD_SOURCEBRANCH"
      } >&2
    fi
    # In Azure Pipelines:  BUILD_SOURCEBRANCH is a full ref path like "refs/heads/mybranch";
    # BUILD_SOURCEBRANCHNAME is a short name like "mybranch"; $BUILD_SOURCEVERSION is a commit ID.
    # Some clients such as `git-clone-related` MUST be given a branch name, not a commit ID.
    CI_BRANCH=$BUILD_SOURCEBRANCHNAME
  elif [ "$TRAVIS" = "true" ]; then
    ## Travis CI
    if [ -n "$debug" ]; then
      echo "Travis CI $TRAVIS" >&2
    fi
    CI_BRANCH=${TRAVIS_PULL_REQUEST_BRANCH:-$TRAVIS_BRANCH}
    if [ -n "$verbose" ]; then
      {
        echo "TRAVIS_PULL_REQUEST_BRANCH=$TRAVIS_PULL_REQUEST_BRANCH"
        echo "TRAVIS_BRANCH=$TRAVIS_BRANCH"
        echo "CI_BRANCH=$CI_BRANCH"
      } >&2
    fi

  elif [ -n "$CIRCLECI" ]; then
    if [ -n "$CIRCLE_PR_NUMBER" ]; then
      # TODO: Can I implement this without a GitHub API request?
      # The request is unauthenticated, so it is subject to throttling.
      # "// empty" maps JSON null to the empty string; the redirection discards
      # jq's complaint if the response is not JSON at all (as when throttling
      # yields an HTML error page).
      api_url="https://api.github.com/repos/${CIRCLE_PROJECT_USERNAME}/${CIRCLE_PROJECT_REPONAME}/pulls/${CIRCLE_PR_NUMBER}"
      CI_PULL_JSON="$(_scoab_get_url "${api_url}" | tr -d '[:cntrl:]')"
      CI_BRANCH=$(printf '%s' "${CI_PULL_JSON}" | jq -r '.head.ref // empty' 2> /dev/null)
      if [ -z "$CI_BRANCH" ]; then
        # For a pull request, this is like "pull/1234" rather than a branch name.
        CI_BRANCH=$CIRCLE_BRANCH
      fi
    else
      CI_BRANCH=$CIRCLE_BRANCH
    fi

  elif [ -n "${GITHUB_HEAD_REF}" ]; then
    # GitHub Actions pull request (no special handling is required for non-PR GitHub Actions jobs).
    # Set this here rather than relying on the organization code above to have
    # done so:  that if/elif chain tests different variables in a different
    # order, so it does not always take the arm that corresponds to this one.
    GITHUB_PR_NUMBER=${GITHUB_REF_NAME%/merge}
    if [ -n "$debug" ]; then
      {
        echo "GitHub Actions pull request https://github.com/${GITHUB_REPOSITORY}/pull/${GITHUB_PR_NUMBER}"
        echo "  GITHUB_BASE_REF=${GITHUB_BASE_REF}"
        echo "  GITHUB_REF_NAME=${GITHUB_REF_NAME}"
        echo "  GITHUB_SHA=${GITHUB_SHA}"
        # GITHUB_HEAD_REF is in the PR fork which is not available.
        echo "  GITHUB_HEAD_REF=${GITHUB_HEAD_REF}"
      } >&2
    fi
    # At this point, these two are the same:
    # git rev-parse HEAD
    # git rev-parse remotes/pull/"${GITHUB_REF_NAME}"

    CI_BRANCH="${GITHUB_HEAD_REF}"

    # If this elif is reached, it's not a pull request (except maybe a re-run Azure Pipelines pull request).
  elif [ -n "$GITHUB_ACTIONS" ]; then
    # GitHub Actions, non-pull-request.
    if [ -n "$debug" ]; then
      echo "GitHub Actions, not a pull request, GITHUB_REF_NAME=${GITHUB_REF_NAME}, GITHUB_SHA=${GITHUB_SHA}, head=$(git rev-parse HEAD)" >&2
    fi

    if [ "${GITHUB_EVENT_NAME}" = "pull_request" ]; then
      echo "${SCRIPT_NAME}: GITHUB_EVENT_NAME=${GITHUB_EVENT_NAME}" >&2
      return 2
    fi

    # GITHUB_REF_NAME may be a branch name or "40/merge".
    if [ -n "$(git branch --list "${GITHUB_REF_NAME}")" ]; then
      CI_BRANCH="${GITHUB_REF_NAME}"
    else
      # TODO: Can I implement this without a GitHub API request?
      # GITHUB_REF_NAME is like "40/merge" here, so strip "/merge" for the PR number.
      api_url="https://api.github.com/repos/${GITHUB_REPOSITORY}/pulls/${GITHUB_REF_NAME%/merge}"
      CI_PULL_JSON="$(_scoab_get_url "${api_url}" | tr -d '[:cntrl:]')"
      CI_BRANCH=$(printf '%s' "${CI_PULL_JSON}" | jq -r '.head.ref // empty' 2> /dev/null)
    fi

  else

    if [ -n "$debug" ]; then
      echo "Else clause: no CI environment detected" >&2
    fi
    # git 2.22 and later has `git branch --show-current`; CircleCI doesn't have that version yet.
    CI_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    # In an Azure Pipelines pull request, `git branch` yields "(HEAD detached at pull/4/merge)".
    # If you re-run a pull request via "Queue" rather than "Rebuild",
    # variables SYSTEM_PULLREQUEST_TARGETBRANCH and SYSTEM_PULLREQUEST_SOURCEBRANCH are not set.
    if [ "$CI_BRANCH" = '(HEAD' ]; then
      CI_BRANCH=$CI_DEFAULT_BRANCH_NAME
    fi
  fi

  if [ -n "$debug" ]; then
    echo "CI_BRANCH=${CI_BRANCH}" >&2
  fi

  ### Set it

  export CI_ORGANIZATION
  export CI_BRANCH
  export CI_DEFAULT_BRANCH_NAME
  if [ -n "$verbose" ]; then
    {
      echo "CI_ORGANIZATION=$CI_ORGANIZATION"
      echo "CI_BRANCH=$CI_BRANCH"
    } >&2
  fi
}

# Give the body shell options that suit it, then restore the client's options.
# The client's `set -u` would abort on the many CI variables that are unset
# outside their own CI service, and its `set -e` would abort on a command whose
# failure this script handles itself.
# Only the two options that this script changes are saved, and they are read
# from "$-" rather than from `set +o`:  bash and BusyBox ash turn errexit off
# inside the command substitution that capturing `set +o` requires, so a
# captured `set +o` would report errexit as off and turn it off in the client.
case $- in
  *e*) _scoab_had_errexit="true" ;;
  *) _scoab_had_errexit="" ;;
esac
case $- in
  *u*) _scoab_had_nounset="true" ;;
  *) _scoab_had_nounset="" ;;
esac
set +e +u

_scoab_set_org_and_branch_body
_scoab_status=$?
if [ "$_scoab_status" -ne 0 ]; then
  # Honor the documented contract:  on failure all four variables are empty.
  # The body returns early from several places, some of them after it has
  # already set a variable; clearing here covers every one of them.
  CI_ORGANIZATION=""
  CI_BRANCH=""
  CI_DEFAULT_BRANCH_NAME=""
  CI_PULL_JSON=""
fi

# Clean up before restoring `set -e`, which makes the shell exit here if the
# client uses `set -e` and this script failed.
unset -f _scoab_set_org_and_branch_body _scoab_get_url _scoab_redact_tokens \
  _scoab_org_from_url
